cwlVersion: v1.2
class: CommandLineTool
baseCommand:
  - virstrain_build
label: virstrain_build
doc: "Build a custom VirStrain database from a multiple sequence alignment (MSA).\n\nTool
  homepage: https://github.com/liaoherui/VirStrain"
inputs:
  - id: input_msa
    type: File
    doc: Input MSA file generated by mafft --- Required
    inputBinding:
      position: 1
      prefix: --input_msa
  - id: db_dir
    type:
      - 'null'
      - string
    doc: 'Database Output dir (default: current workdir/VirStrain_DB)'
    inputBinding:
      position: 2
      prefix: --database_dir
  - id: dash_cutoff
    type:
      - 'null'
      - float
    doc: 'The cutoff of dash in each column of MSA (default: 0)'
    inputBinding:
      position: 3
      prefix: --dash_cutoff
  - id: sites_ratio_cutoff
    type:
      - 'null'
      - float
    doc: The cutoff of sites number for manual-covering function (eg. 1 means 
      all useful sites will be used and 0.8 means 80% useful sites will be 
      used.)
    inputBinding:
      position: 4
      prefix: --sites_ratio_cutoff
  - id: sites_range_cutoff
    type:
      - 'null'
      - string
    doc: The cutoff of sites range for covering algorithm (eg. 3-500 means the 
      covering algorithm will only consider the SNV sites from 3-500 of MSA.)
    inputBinding:
      position: 5
      prefix: --sites_range_cutoff
outputs:
  - id: db_dir_dir
    type:
      - 'null'
      - Directory
    doc: 'Database Output dir (default: current workdir/VirStrain_DB)'
    outputBinding:
      glob: $(inputs.db_dir)
  - id: stdout
    type: stdout
    doc: Standard output
hints:
  - class: DockerRequirement
    dockerPull: quay.io/biocontainers/virstrain:1.17--pyhdfd78af_1
stdout: virstrain_build.out
