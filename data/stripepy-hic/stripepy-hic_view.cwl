cwlVersion: v1.2
class: CommandLineTool
baseCommand:
  - stripepy
  - view
label: stripepy-hic_view
doc: "Fetch stripes from the HDF5 file produced by stripepy call and print them as a table.\n\nTool homepage: https://github.com/paulsengroup/StripePy"
inputs:
  - id: h5_file
    type: File
    doc: Path to the HDF5 file generated by stripepy call.
    inputBinding:
      position: 101
  - id: relative_change_threshold
    type:
      - 'null'
      - float
    doc: Cutoff for the relative change (default 5.0)
    inputBinding:
      position: 1
      prefix: --relative-change-threshold
  - id: coefficient_of_variation_threshold
    type:
      - 'null'
      - float
    doc: Cutoff for the coefficient of variation (default None)
    inputBinding:
      position: 1
      prefix: --coefficient-of-variation-threshold
  - id: with_biodescriptors
    type:
      - 'null'
      - boolean
    doc: Include the stripe biodescriptors in the output.
    inputBinding:
      position: 1
      prefix: --with-biodescriptors
  - id: with_header
    type:
      - 'null'
      - boolean
    doc: Include column names in the output.
    inputBinding:
      position: 1
      prefix: --with-header
  - id: transform
    type:
      - 'null'
      - string
    doc: Control if and how stripe coordinates should be transformed (None, transpose_to_lt, transpose_to_ut)
    inputBinding:
      position: 1
      prefix: --transform
  - id: verbosity
    type:
      - 'null'
      - string
    doc: Set verbosity of output to the console (debug, info, warning, error, critical; default info)
    inputBinding:
      position: 1
      prefix: --verbosity
outputs:
  - id: stripes
    type: stdout
    doc: Stripes as tab-separated text
stdout: stripepy-hic_view.out
requirements:
  - class: InlineJavascriptRequirement
hints:
  - class: DockerRequirement
    dockerPull: quay.io/biocontainers/stripepy-hic:1.3.0--pyh2a3209d_1
