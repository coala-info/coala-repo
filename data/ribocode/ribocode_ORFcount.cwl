cwlVersion: v1.2
class: CommandLineTool
baseCommand: ORFcount
label: ribocode_ORFcount
doc: "This script is designed for calculating the number of reads mapping to ORF\n\
  with the alignment files in SAM/BAM format (aligned to genome) and a feature\nfile
  in GTF format\n\nTool homepage: https://github.com/xryanglab/RiboCode"
inputs:
  - id: rpf_mapping_file
    type: File
    secondaryFiles:
      - .bai
    doc: ribo-seq BAM/SAM file aligned to the genome
    inputBinding:
      position: 101
      prefix: --rpf_mapping_file
  - id: gtf_file
    type:
      - 'null'
      - File
    doc: ORF gtf file generated by RiboCode
    inputBinding:
      position: 101
      prefix: --gtf
  - id: stranded
    type:
      - 'null'
      - string
    doc: whether the data is strand-specific (yes, reverse or no), reverse means 
      reversed strand interpretation. (default yes)
    inputBinding:
      position: 101
      prefix: --stranded
  - id: min_quality
    type:
      - 'null'
      - int
    doc: skip all reads with alignment quality lower than the given minimum 
      value (default 10)
    inputBinding:
      position: 101
      prefix: --minaqual
  - id: count_mode
    type:
      - 'null'
      - string
    doc: mode to handle reads overlapping more than one ORF (union or 
      intersection-strict; default intersection-strict)
    inputBinding:
      position: 101
      prefix: --count_mode
  - id: first_exclude_codons
    type:
      - 'null'
      - int
    doc: excluding the reads aligned to the first few codons of the ORF 
      (default 15)
    inputBinding:
      position: 101
      prefix: --first_exclude_codons
  - id: last_exclude_codons
    type:
      - 'null'
      - int
    doc: excluding the reads aligned to the last few codons of the ORF (default 
      5)
    inputBinding:
      position: 101
      prefix: --last_exclude_codons
  - id: exclude_min_orf
    type:
      - 'null'
      - int
    doc: the minimal length(nt) of ORF for excluding the reads aligned to first 
      and last few codons (default 100)
    inputBinding:
      position: 101
      prefix: --exclude_min_ORF
  - id: min_read
    type:
      - 'null'
      - int
    doc: minimal read length for the counting of RPF (default 26)
    inputBinding:
      position: 101
      prefix: --min_read
  - id: max_read
    type:
      - 'null'
      - int
    doc: maximal read length for the counting of RPF (default 34)
    inputBinding:
      position: 101
      prefix: --max_read
  - id: output_file
    type:
      - 'null'
      - string
    doc: write out all ORF counts into a file, default is to write to standard 
      output
    inputBinding:
      position: 101
      prefix: --output
outputs:
  - id: orf_counts
    type:
      - 'null'
      - File
    doc: ORF count table (written when --output is given)
    outputBinding:
      glob: $(inputs.output_file)
  - id: stdout
    type: stdout
    doc: Standard output
requirements:
  - class: InlineJavascriptRequirement
hints:
  - class: DockerRequirement
    dockerPull: quay.io/biocontainers/ribocode:1.2.15--pyhdc42f0e_1
stdout: ribocode_ORFcount.out
