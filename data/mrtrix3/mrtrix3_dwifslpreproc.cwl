cwlVersion: v1.2
class: CommandLineTool
label: mrtrix3_dwifslpreproc
doc: "Perform diffusion image pre-processing using FSL's eddy tool; including inhomogeneity distortion correction using FSL's topup tool if possible\n\nTool homepage: https://www.mrtrix.org"
baseCommand: [dwifslpreproc]
hints:
  - class: DockerRequirement
    dockerPull: quay.io/biocontainers/mrtrix3:3.0.8--h8aef656_0
inputs:
  - id: input
    type: File
    doc: "The input DWI series to be corrected"
    inputBinding:
      position: 10
  - id: output
    type: string
    doc: "The output corrected image series"
    inputBinding:
      position: 11
  - id: pe_dir
    type: ['null', string]
    doc: "Manually specify the phase encoding direction of the input series; can be a signed axis number (e.g. -0, 1, +2), an axis designator (e.g. RL, PA, IS), or NIfTI axis codes (e.g. i-, j, k)"
    inputBinding:
      prefix: -pe_dir
  - id: readout_time
    type: ['null', float]
    doc: "Manually specify the total readout time of the input series (in seconds)"
    inputBinding:
      prefix: -readout_time
  - id: se_epi
    type: ['null', File]
    doc: "Provide an additional image series consisting of spin-echo EPI images, which is to be used exclusively by topup for estimating the inhomogeneity field (i.e. it will not form part of the output image series)"
    inputBinding:
      prefix: -se_epi
  - id: align_seepi
    type: ['null', boolean]
    doc: "Achieve alignment between the SE-EPI images used for inhomogeneity field estimation, and the DWIs (more information in Description section)"
    inputBinding:
      prefix: -align_seepi
  - id: json_import
    type: ['null', File]
    doc: "Import image header information from an associated JSON file (may be necessary to determine phase encoding information)"
    inputBinding:
      prefix: -json_import
  - id: topup_options
    type: ['null', string]
    doc: "Manually provide additional command-line options to the topup command (provide a string within quotation marks that contains at least one space, even if only passing a single command-line option to topup)"
    inputBinding:
      prefix: -topup_options
  - id: eddy_options
    type: ['null', string]
    doc: "Manually provide additional command-line options to the eddy command (provide a string within quotation marks that contains at least one space, even if only passing a single command-line option to eddy)"
    inputBinding:
      prefix: -eddy_options
  - id: eddy_mask
    type: ['null', File]
    doc: "Provide a processing mask to use for eddy, instead of having dwifslpreproc generate one internally using dwi2mask"
    inputBinding:
      prefix: -eddy_mask
  - id: eddy_slspec
    type: ['null', File]
    doc: "Provide a file containing slice groupings for eddy's slice-to-volume registration"
    inputBinding:
      prefix: -eddy_slspec
  - id: eddyqc_text
    type: ['null', string]
    doc: "Copy the various text-based statistical outputs generated by eddy, and the output of eddy_qc (if installed), into an output directory"
    inputBinding:
      prefix: -eddyqc_text
  - id: eddyqc_all
    type: ['null', string]
    doc: "Copy ALL outputs generated by eddy (including images), and the output of eddy_qc (if installed), into an output directory"
    inputBinding:
      prefix: -eddyqc_all
  - id: rpe_none
    type: ['null', boolean]
    doc: "Specify that no reversed phase-encoding image data is being provided; eddy will perform eddy current and motion correction only"
    inputBinding:
      prefix: -rpe_none
  - id: rpe_pair
    type: ['null', boolean]
    doc: "Specify that a set of images (typically b=0 volumes) will be provided for use in inhomogeneity field estimation only (using the -se_epi option)"
    inputBinding:
      prefix: -rpe_pair
  - id: rpe_all
    type: ['null', boolean]
    doc: "Specify that ALL DWIs have been acquired with opposing phase-encoding"
    inputBinding:
      prefix: -rpe_all
  - id: rpe_header
    type: ['null', boolean]
    doc: "Specify that the phase-encoding information can be found in the image header(s), and that this is the information that the script should use"
    inputBinding:
      prefix: -rpe_header
  - id: grad
    type: ['null', File]
    doc: "Provide the diffusion gradient table in MRtrix format"
    inputBinding:
      prefix: -grad
  - id: fslgrad
    type:
      - 'null'
      - type: array
        items: File
    doc: "Provide the diffusion gradient table in FSL bvecs/bvals format"
    inputBinding:
      prefix: -fslgrad
  - id: export_grad_mrtrix
    type: ['null', string]
    doc: "Export the final gradient table in MRtrix format"
    inputBinding:
      prefix: -export_grad_mrtrix
  - id: export_grad_fsl
    type:
      - 'null'
      - type: array
        items: string
    doc: "Export the final gradient table in FSL bvecs/bvals format"
    inputBinding:
      prefix: -export_grad_fsl
  - id: nocleanup
    type: ['null', boolean]
    doc: "do not delete intermediate files during script execution, and do not delete scratch directory at script completion."
    inputBinding:
      prefix: -nocleanup
  - id: scratch
    type: ['null', string]
    doc: "manually specify the path in which to generate the scratch directory."
    inputBinding:
      prefix: -scratch
  - id: continue
    type:
      - 'null'
      - type: array
        items: string
    doc: "continue the script from a previous execution; must provide the scratch directory path, and the name of the last successfully-generated file."
    inputBinding:
      prefix: -continue
  - id: info
    type: ['null', boolean]
    doc: "display information messages."
    inputBinding:
      prefix: -info
  - id: quiet
    type: ['null', boolean]
    doc: "do not display information messages or progress status. Alternatively, this can be achieved by setting the MRTRIX_QUIET environment variable to a non- empty string."
    inputBinding:
      prefix: -quiet
  - id: debug
    type: ['null', boolean]
    doc: "display debugging messages."
    inputBinding:
      prefix: -debug
  - id: force
    type: ['null', boolean]
    doc: "force overwrite of output files."
    inputBinding:
      prefix: -force
  - id: nthreads
    type: ['null', int]
    doc: "use this number of threads in multi-threaded applications (set to 0 to disable multi-threading)."
    inputBinding:
      prefix: -nthreads
  - id: config
    type:
      - 'null'
      - type: array
        items: string
    doc: "temporarily set the value of an MRtrix config file entry."
    inputBinding:
      prefix: -config
outputs:
  - id: output_file
    type: File
    doc: "The output corrected image series"
    outputBinding:
      glob: $(inputs.output)
  - id: eddyqc_text_dir
    type: ['null', Directory]
    doc: "Copy the various text-based statistical outputs generated by eddy, and the output of eddy_qc (if installed), into an output directory"
    outputBinding:
      glob: $(inputs.eddyqc_text)
  - id: eddyqc_all_dir
    type: ['null', Directory]
    doc: "Copy ALL outputs generated by eddy (including images), and the output of eddy_qc (if installed), into an output directory"
    outputBinding:
      glob: $(inputs.eddyqc_all)
  - id: export_grad_mrtrix_file
    type: ['null', File]
    doc: "Export the final gradient table in MRtrix format"
    outputBinding:
      glob: $(inputs.export_grad_mrtrix)
  - id: export_grad_fsl_files
    type:
      - 'null'
      - type: array
        items: File
    doc: "Export the final gradient table in FSL bvecs/bvals format"
    outputBinding:
      glob: $(inputs.export_grad_fsl)
