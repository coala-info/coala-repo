cwlVersion: v1.2
class: CommandLineTool
baseCommand: talon_label_reads
label: talon_label_reads
doc: "Read SAM-formatted long read alignments and add a custom tag with the fraction of As in the sequence immediately following the alignment. This helps to flag internal priming artifacts.\n\nTool homepage: https://github.com/mortazavilab/TALON"
inputs:
  - id: sam_file
    type: File
    doc: SAM file of transcripts
    inputBinding:
      position: 101
      prefix: --f
  - id: genome_file
    type: File
    doc: Reference genome fasta file
    inputBinding:
      position: 101
      prefix: --g
  - id: threads
    type:
      - 'null'
      - int
    doc: Number of threads to run
    inputBinding:
      position: 101
      prefix: --t
  - id: fraca_range_size
    type:
      - 'null'
      - int
    doc: Size of post-transcript interval to compute fraction As on. Default = 20
    inputBinding:
      position: 101
      prefix: --ar
  - id: tmp_dir
    type:
      - 'null'
      - string
    doc: Path to directory for tmp files. Default = tmp_label_reads
    inputBinding:
      position: 101
      prefix: --tmpDir
  - id: delete_tmp
    type:
      - 'null'
      - boolean
    doc: If this option is set, the temporary directory generated by the program will be removed at the end of the run.
    inputBinding:
      position: 101
      prefix: --deleteTmp
  - id: outprefix
    type: string
    doc: Prefix for outfiles
    inputBinding:
      position: 101
      prefix: --o
outputs:
  - id: labeled_sam
    type: File
    doc: SAM file with the fraction-A tag added
    outputBinding:
      glob: $(inputs.outprefix)_labeled.sam
  - id: read_labels
    type:
      - 'null'
      - File
    doc: Read label table
    outputBinding:
      glob: $(inputs.outprefix)_read_labels.tsv
requirements:
  - class: InitialWorkDirRequirement
    listing:
      - entry: $(inputs.genome_file)
        writable: true
hints:
  - class: DockerRequirement
    dockerPull: quay.io/biocontainers/talon:6.0.1--pyhdfd78af_0
