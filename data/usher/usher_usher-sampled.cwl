cwlVersion: v1.2
class: CommandLineTool
baseCommand: usher-sampled
label: usher_usher-sampled
doc: 'UShER (v0.6.6) usher-sampled: places new samples from a VCF onto a mutation-annotated
  tree (sampled-order, optimizing placement).


  Tool homepage: https://github.com/yatisht/usher'
inputs:
- id: vcf
  type: File
  doc: Input VCF file (in uncompressed or gzip-compressed .gz format) [REQUIRED]
  inputBinding:
    position: 101
    prefix: --vcf
- id: tree
  type:
  - 'null'
  - File
  doc: Input tree file
  inputBinding:
    position: 101
    prefix: --tree
- id: outdir
  type:
  - 'null'
  - string
  doc: 'Output directory to dump output and log files [DEFAULT uses current directory]
    [default: .]'
  inputBinding:
    position: 101
    prefix: --outdir
- id: load_mutation_annotated_tree
  type:
  - 'null'
  - File
  doc: Load mutation-annotated tree object
  inputBinding:
    position: 101
    prefix: --load-mutation-annotated-tree
- id: save_mutation_annotated_tree
  type:
  - 'null'
  - string
  doc: Save output mutation-annotated tree object to the specified filename
  inputBinding:
    position: 101
    prefix: --save-mutation-annotated-tree
- id: sort_before_placement_1
  type:
  - 'null'
  - boolean
  doc: Sort new samples based on computed parsimony score and then number of optimal
    placements before the actual placement [EXPERIMENTAL].
  inputBinding:
    position: 101
    prefix: --sort-before-placement-1
- id: sort_before_placement_2
  type:
  - 'null'
  - boolean
  doc: Sort new samples based on the number of optimal placements and then the parsimony
    score before the actual placement [EXPERIMENTAL].
  inputBinding:
    position: 101
    prefix: --sort-before-placement-2
- id: sort_before_placement_3
  type:
  - 'null'
  - boolean
  doc: Sort new samples based on the number of ambiguous bases [EXPERIMENTAL].
  inputBinding:
    position: 101
    prefix: --sort-before-placement-3
- id: reverse_sort
  type:
  - 'null'
  - boolean
  doc: Reverse the sorting order of sorting options (sort-before-placement-1 or sort-before-placement-2)
    [EXPERIMENTAL]
  inputBinding:
    position: 101
    prefix: --reverse-sort
- id: collapse_tree
  type:
  - 'null'
  - boolean
  doc: Collapse internal nodes of the input tree with no mutations and condense identical
    sequences in polytomies into a single node and the save the tree to file condensed-tree.nh
    in outdir
  inputBinding:
    position: 101
    prefix: --collapse-tree
- id: collapse_output_tree
  type:
  - 'null'
  - boolean
  doc: Collapse internal nodes of the output tree with no mutations before the saving
    the tree to file final-tree.nh in outdir
  inputBinding:
    position: 101
    prefix: --collapse-output-tree
- id: max_uncertainty_per_sample
  type:
  - 'null'
  - int
  doc: 'Maximum number of equally parsimonious placements allowed per sample beyond
    which the sample is ignored [default: 1000000]'
  inputBinding:
    position: 101
    prefix: --max-uncertainty-per-sample
- id: max_parsimony_per_sample
  type:
  - 'null'
  - int
  doc: 'Maximum parsimony score of the most parsimonious placement(s) allowed per
    sample beyond which the sample is ignored [default: 1000000]'
  inputBinding:
    position: 101
    prefix: --max-parsimony-per-sample
- id: write_uncondensed_final_tree
  type:
  - 'null'
  - boolean
  doc: Write the final tree in uncondensed format and save to file uncondensed-final-tree.nh
    in outdir
  inputBinding:
    position: 101
    prefix: --write-uncondensed-final-tree
- id: write_subtrees_size
  type:
  - 'null'
  - int
  doc: 'Write minimum set of subtrees covering the newly added samples of size equal
    to this value [default: 0]'
  inputBinding:
    position: 101
    prefix: --write-subtrees-size
- id: write_single_subtree
  type:
  - 'null'
  - int
  doc: 'Similar to write-subtrees-size but produces a single subtree with all newly
    added samples along with random samples up to the value specified by this argument
    [default: 0]'
  inputBinding:
    position: 101
    prefix: --write-single-subtree
- id: anchor_samples
  type:
  - 'null'
  - File
  doc: Add samples from file to subtree(s) generated by --write-subtrees-size and/or
    --write-single-subtree (e.g. to provide larger-scale context by including well-known
    vaccine strains)
  inputBinding:
    position: 101
    prefix: --anchor-samples
- id: multiple_placements
  type:
  - 'null'
  - int
  doc: 'Create a new tree up to this limit for each possibility of parsimony-optimal
    placement [default: 1]'
  inputBinding:
    position: 101
    prefix: --multiple-placements
- id: retain_input_branch_lengths
  type:
  - 'null'
  - boolean
  doc: Retain the branch lengths from the input tree in out newick files instead of
    using number of mutations for the branch lengths.
  inputBinding:
    position: 101
    prefix: --retain-input-branch-lengths
- id: no_add
  type:
  - 'null'
  - boolean
  doc: Do not add new samples to the tree
  inputBinding:
    position: 101
    prefix: --no-add
- id: detailed_clades
  type:
  - 'null'
  - boolean
  doc: In clades.txt, write a histogram of annotated clades and counts across all
    equally parsimonious placements
  inputBinding:
    position: 101
    prefix: --detailed-clades
- id: diff
  type:
  - 'null'
  - File
  doc: diff file from MAPLE, to be used with reference sequence
  inputBinding:
    position: 101
    prefix: --diff
- id: ref
  type:
  - 'null'
  - File
  doc: reference sequence, only needed for MAPLE
  inputBinding:
    position: 101
    prefix: --ref
- id: threads
  type:
  - 'null'
  - int
  doc: 'Number of threads to use when possible [DEFAULT uses all available cores,
    20 detected on this machine] [default: 20]'
  inputBinding:
    position: 101
    prefix: --threads
- id: reduce_back_mutation
  type:
  - 'null'
  - boolean
  doc: Reassign states of internal nodes to reduce back mutation count.
  inputBinding:
    position: 101
    prefix: --reduce-back-mutation
- id: optimization_radius
  type:
  - 'null'
  - int
  doc: 'The search radius for optimization when parsimony score increase exceeds the
    thresholdSet to 0 to disable optimiationOnly newly placed samples and nodes within
    this radius will be searched [default: 4]'
  inputBinding:
    position: 101
    prefix: --optimization_radius
- id: optimization_minutes
  type:
  - 'null'
  - int
  doc: 'Optimization time of each iterations in minutesSet to 0 to disable optimiationOnly
    newly placed samples and nodes within this radius will be searched [default: 5]'
  inputBinding:
    position: 101
    prefix: --optimization_minutes
- id: last_optimization_minutes
  type:
  - 'null'
  - int
  doc: 'Optimization radius for the last round [default: 120]'
  inputBinding:
    position: 101
    prefix: --last_optimization_minutes
- id: batch_size_per_process
  type:
  - 'null'
  - int
  doc: 'The number of samples each process search simultaneously [default: 5]'
  inputBinding:
    position: 101
    prefix: --batch_size_per_process
- id: parsimony_threshold
  type:
  - 'null'
  - int
  doc: 'Optimize after the parsimony score increase by this amount [default: 100000]'
  inputBinding:
    position: 101
    prefix: --parsimony_threshold
- id: first_n_samples
  type:
  - 'null'
  - int
  doc: '[TESTING ONLY] Only place first n samples [default: 18446744073709551615]'
  inputBinding:
    position: 101
    prefix: --first_n_samples
- id: no_ignore_prefix
  type:
  - 'null'
  - string
  doc: prefix samples already in the tree to force placement
  inputBinding:
    position: 101
    prefix: --no-ignore-prefix
outputs:
- id: outdir_dir
  type:
  - 'null'
  - Directory
  doc: Directory named by --outdir
  outputBinding:
    glob: '${ return inputs.outdir ? inputs.outdir : []; }'
- id: save_mutation_annotated_tree_file
  type:
  - 'null'
  - File
  doc: Output file named by --save-mutation-annotated-tree. Save output mutation-annotated
    tree object to the specified filename
  outputBinding:
    glob: '${ return inputs.save_mutation_annotated_tree ? inputs.save_mutation_annotated_tree
      : []; }'
- id: stdout_log
  type: stdout
  doc: Standard output (progress messages).
stdout: usher-sampled_stdout.txt
requirements:
- class: InlineJavascriptRequirement
hints:
- class: DockerRequirement
  dockerPull: quay.io/biocontainers/usher:0.6.6--hdd55de9_4
