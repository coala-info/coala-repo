cwlVersion: v1.2
class: CommandLineTool
baseCommand: predictosaurus
arguments:
  - position: 2
    valueFrom: peptides
label: predictosaurus_peptides
doc: "Output all distinct peptides from the given features to a fastq file per given
  CDS in the feature file\n\nTool homepage: https://github.com/fxwiegand/predictosaurus"
inputs:
  - id: threads
    type:
      - 'null'
      - int
    doc: Number of threads to use (global option, placed before the subcommand; default all available cores)
    inputBinding:
      position: 1
      prefix: --threads
  - id: background_events
    type:
      - 'null'
      - type: array
        items: string
        inputBinding:
          prefix: --background-events
    doc: Background events (repeat the option for each event)
    inputBinding:
      position: 101
  - id: events
    type:
      - 'null'
      - type: array
        items: string
        inputBinding:
          prefix: --events
    doc: Events of interest (repeat the option for each event)
    inputBinding:
      position: 101
  - id: features
    type: File
    doc: Path to the gff file containing the features of interest
    inputBinding:
      position: 101
      prefix: --features
  - id: graph
    type: File
    doc: Path to the graph file generated by the build command
    inputBinding:
      position: 101
      prefix: --graph
  - id: interval
    type:
      - 'null'
      - string
    doc: Interval for peptide lengths to be generated in the format `start-end`
    inputBinding:
      position: 101
      prefix: --interval
  - id: max_background_event_prob
    type: float
    inputBinding:
      position: 101
      prefix: --max-background-event-prob
  - id: max_cds_length
    type:
      - 'null'
      - int
    doc: Maximum CDS length to consider for processing. Transcripts containing 
      longer CDSs will be ignored with a warning
    inputBinding:
      position: 101
      prefix: --max-cds-length
  - id: min_event_prob
    type: float
    inputBinding:
      position: 101
      prefix: --min-event-prob
  - id: reference
    type: File
    doc: Path to reference genome fasta file
    secondaryFiles:
      - .fai
    inputBinding:
      position: 101
      prefix: --reference
  - id: sample
    type: string
    doc: Sample name used to retrieve allele frequencies from the graph
    inputBinding:
      position: 101
      prefix: --sample
  - id: verbose
    type:
      - 'null'
      - boolean
    inputBinding:
      position: 101
      prefix: --verbose
  - id: output_path
    type: string
    inputBinding:
      position: 102
      prefix: --output
outputs:
  - id: output
    type: File
    doc: Peptide FASTA file (the help says directory, but the tool writes a single file)
    outputBinding:
      glob: $(inputs.output_path)
requirements:
  - class: InlineJavascriptRequirement
  - class: InitialWorkDirRequirement
    listing:
      - entry: $(inputs.graph)
        writable: true
hints:
  - class: DockerRequirement
    dockerPull: quay.io/biocontainers/predictosaurus:0.8.4--hbcba35e_0
