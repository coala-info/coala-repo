cwlVersion: v1.2
class: CommandLineTool
baseCommand:
  - pgap2
  - post
  - baps
label: pgap2_post_baps
doc: "Workflow for Bayesian analysis of population structure (core alignment, tree, recombination masking, fastbaps).\n\nTool homepage: https://github.com/bucongfan/PGAP2"
inputs:
  - id: indir
    type: Directory
    doc: "Input directory generated by the partition step (pgap2 main)"
    inputBinding:
      position: 101
      prefix: --indir
      valueFrom: $(self.basename)
  - id: nodraw
    type:
      - 'null'
      - boolean
    doc: "Only output flat file, but no drawing plot"
    inputBinding:
      position: 101
      prefix: --nodraw
  - id: msa_method
    type:
      - 'null'
      - string
    doc: "The method of multiple sequence alignment - mafft, muscle or tcoffee (default mafft)"
    inputBinding:
      position: 101
      prefix: --msa_method
  - id: tree_method
    type:
      - 'null'
      - string
    doc: "The method of tree building - fasttree, raxml or iqtree (default fasttree)"
    inputBinding:
      position: 101
      prefix: --tree_method
  - id: para_strategy
    type:
      - 'null'
      - string
    doc: "The strategy of paralog including cluster. best - keep the best one; drop - drop all paralogs contained clusters"
    inputBinding:
      position: 101
      prefix: --para_strategy
  - id: also_pan
    type:
      - 'null'
      - boolean
    doc: "Also output pan genome alignment"
    inputBinding:
      position: 101
      prefix: --also_pan
  - id: fastbaps_levels
    type:
      - 'null'
      - int
    doc: "Parameter of fastbaps (default 2)"
    inputBinding:
      position: 101
      prefix: --fastbaps_levels
  - id: fastbaps_prior
    type:
      - 'null'
      - string
    doc: "Parameter of fastbaps - symmetric, baps, optimise.symmetric or optimise.baps"
    inputBinding:
      position: 101
      prefix: --fastbaps_prior
  - id: core_threshold
    type:
      - 'null'
      - float
    doc: "Core threshold to extract for tree construction (default 0.95)"
    inputBinding:
      position: 101
      prefix: --core_threshold
  - id: step
    type:
      - 'null'
      - int
    doc: "Terminate at this step (1-10); steps 1-6 as in singletree, 7 recombination inference with ClonalFrameML, 8 mask the recombination region with maskrc-svg, 9 reconstruct the phylogeny tree, 10 population structure analysis with fastbaps"
    inputBinding:
      position: 101
      prefix: --step
  - id: add_paras
    type:
      - 'null'
      - string
    doc: "Add additional parameters in a step. Format like Step number:Parameters, such as 6:-pseudo"
    inputBinding:
      position: 101
      prefix: --add_paras
  - id: verbose
    type:
      - 'null'
      - boolean
    doc: "Verbose output"
    inputBinding:
      position: 101
      prefix: --verbose
  - id: debug
    type:
      - 'null'
      - boolean
    doc: "Debug mode. Note: very verbose"
    inputBinding:
      position: 101
      prefix: --debug
  - id: disable
    type:
      - 'null'
      - boolean
    doc: "Disable progress bar"
    inputBinding:
      position: 101
      prefix: --disable
  - id: threads
    type:
      - 'null'
      - int
    doc: "Threads used in parallel"
    inputBinding:
      position: 101
      prefix: --threads
  - id: outdir
    type:
      - 'null'
      - string
    doc: "Output directory"
    inputBinding:
      position: 101
      prefix: --outdir
outputs:
  - id: stdout
    type: stdout
    doc: "Standard output"
  - id: outdir_dir
    type:
      - 'null'
      - Directory
    doc: "Output directory"
    outputBinding:
      glob: $(inputs.outdir)
arguments:
  - position: 200
    shellQuote: false
    valueFrom: >-
      && find $(inputs.outdir || '.') -type l -exec sh -c 'cp -L "$1" "$1.tmp" &&
      mv "$1.tmp" "$1"' _ {} \;
requirements:
  - class: ShellCommandRequirement
  - class: InlineJavascriptRequirement
  - class: InitialWorkDirRequirement
    listing:
      - entry: $(inputs.indir)
        entryname: $(inputs.indir.basename)
        writable: true
hints:
  - class: DockerRequirement
    dockerPull: quay.io/biocontainers/pgap2:1.1.0--pyhdfd78af_0
    dockerOutputDirectory: /pgap2_out
stdout: pgap2_post_baps.out
