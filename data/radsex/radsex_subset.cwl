cwlVersion: v1.2
class: CommandLineTool
baseCommand:
  - radsex
  - subset
label: radsex_subset
doc: "Extracts a subset of a marker depths table.\n\nTool homepage: https://github.com/SexGenomicsToolkit/radsex"
inputs:
  - id: markers_table
    type: File
    doc: Path to a marker depths table generated by "process"
    inputBinding:
      position: 101
      prefix: --markers-table
  - id: popmap
    type: File
    doc: Path to a tabulated file specifying groups for all individuals (population
      map)
    inputBinding:
      position: 101
      prefix: --popmap
  - id: min_depth
    type:
      - 'null'
      - int
    doc: Minimum depth to consider a marker present in an individual (default 1)
    inputBinding:
      position: 101
      prefix: --min-depth
  - id: groups
    type:
      - 'null'
      - string
    doc: Names of the groups to compare if there are more than two groups in the popmap
      (group1,group2)
    inputBinding:
      position: 101
      prefix: --groups
  - id: signif_threshold
    type:
      - 'null'
      - float
    doc: P-value threshold to consider a marker significantly associated with a phenotypic
      group (default 0.05)
    inputBinding:
      position: 101
      prefix: --signif-threshold
  - id: disable_correction
    type:
      - 'null'
      - boolean
    doc: If set, Bonferroni correction will NOT be used when assessing significance
      of association with phenotypic group
    inputBinding:
      position: 101
      prefix: --disable-correction
  - id: output_fasta
    type:
      - 'null'
      - boolean
    doc: If set, markers will be output in fasta format instead of table format
    inputBinding:
      position: 101
      prefix: --output-fasta
  - id: min_group1
    type:
      - 'null'
      - int
    doc: Minimum number of individuals from the first group to retain a marker in
      the subset (default 0)
    inputBinding:
      position: 101
      prefix: --min-group1
  - id: min_group2
    type:
      - 'null'
      - int
    doc: Minimum number of individuals from the second group to retain a marker in
      the subset (default 0)
    inputBinding:
      position: 101
      prefix: --min-group2
  - id: max_group1
    type:
      - 'null'
      - int
    doc: Maximum number of individuals from the first group to retain a marker in
      the subset (default 9999)
    inputBinding:
      position: 101
      prefix: --max-group1
  - id: max_group2
    type:
      - 'null'
      - int
    doc: Maximum number of individuals from the second group to retain a marker in
      the subset (default 9999)
    inputBinding:
      position: 101
      prefix: --max-group2
  - id: min_individuals
    type:
      - 'null'
      - int
    doc: Minimum number of individuals to retain a marker in the subset (default 0)
    inputBinding:
      position: 101
      prefix: --min-individuals
  - id: max_individuals
    type:
      - 'null'
      - int
    doc: Maximum number of individuals to retain a marker in the subset (default 9999)
    inputBinding:
      position: 101
      prefix: --max-individuals
  - id: output_file_path
    type: string
    doc: Path to the output file (marker depths table or fasta file for extracted
      markers)
    inputBinding:
      position: 102
      prefix: --output-file
outputs:
  - id: output_file
    type: File
    doc: Path to the output file (marker depths table or fasta file for extracted
      markers)
    outputBinding:
      glob: $(inputs.output_file_path)
hints:
  - class: DockerRequirement
    dockerPull: quay.io/biocontainers/radsex:1.2.0--h43eeafb_3
