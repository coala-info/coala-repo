cwlVersion: v1.2
class: CommandLineTool
baseCommand: [plink2vcf]
label: rvtests_plink2vcf
doc: "Convert binary PLINK files (.bed/.bim/.fam) to a VCF file. The output file is named exactly as --outVcf; a .log file is written beside it.\n\nTool homepage: https://github.com/zhanxw/rvtests"
inputs:
  - id: in_plink
    type: File
    secondaryFiles:
      - pattern: ^.bim
        required: true
      - pattern: ^.fam
        required: true
    doc: "Input PLINK binary genotype file (.bed); the .bim and .fam files with the same base name must exist beside it. Passed to the tool as the prefix."
    inputBinding:
      position: 101
      prefix: --inPlink
      valueFrom: "$(self.dirname)/$(self.nameroot)"
  - id: out_vcf
    type: string
    default: output.vcf
    doc: "Output VCF file name (written as given, not compressed)"
    inputBinding:
      position: 101
      prefix: --outVcf
  - id: reference
    type:
      - 'null'
      - File
    doc: "Reference file (format: rsNumber reference_base), can be generated by getMapRef"
    inputBinding:
      position: 101
      prefix: --reference
outputs:
  - id: vcf
    type: File
    doc: "Converted VCF file"
    outputBinding:
      glob: "$(inputs.out_vcf)"
  - id: out_log
    type: File
    doc: "Log file"
    outputBinding:
      glob: "$(inputs.out_vcf).log"
hints:
  - class: DockerRequirement
    dockerPull: quay.io/biocontainers/rvtests:2.0.7--h3d151dd_2
