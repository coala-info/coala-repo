cwlVersion: v1.2
class: CommandLineTool
baseCommand: reads_across_time.py
label: wub_reads_across_time.py
doc: "Plot read and alignment properties across time.\n\nTool homepage: https://github.com/nanoporetech/wub"
inputs:
  - id: time_tab
    type: File
    doc: "Tab separated file generated by fastq_time_tab.py"
    inputBinding:
      position: 1
      prefix: -i
  - id: aln_tab
    type: File
    doc: "Tab separated file generated by bam_alignment_length.py"
    inputBinding:
      position: 2
      prefix: -a
  - id: res_freq
    type:
      - 'null'
      - float
    doc: "Resampling frequency in minutes (5)."
    inputBinding:
      position: 3
      prefix: -w
  - id: report_pdf
    type:
      - 'null'
      - string
    doc: "Report PDF (reads_across_time.pdf)."
    inputBinding:
      position: 4
      prefix: -r
  - id: out_tsv
    type:
      - 'null'
      - string
    doc: "Output tsv (reads_across_time.tsv)."
    inputBinding:
      position: 5
      prefix: -t
outputs:
  - id: report
    type: File
    doc: "Report with plots across time"
    outputBinding:
      glob: '${ return inputs.report_pdf ? inputs.report_pdf : "reads_across_time.pdf"; }'
  - id: output_tsv
    type: File
    doc: "Merged read and alignment table"
    outputBinding:
      glob: '${ return inputs.out_tsv ? inputs.out_tsv : "reads_across_time.tsv"; }'
requirements:
  - class: InlineJavascriptRequirement
hints:
  - class: DockerRequirement
    dockerPull: quay.io/biocontainers/wub:0.5.1--pyh3252c3a_0
