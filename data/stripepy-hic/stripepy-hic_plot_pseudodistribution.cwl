cwlVersion: v1.2
class: CommandLineTool
baseCommand:
  - stripepy
  - plot
  - pseudodistribution
label: stripepy-hic_plot_pseudodistribution
doc: "Plot the pseudo-distribution over the given region of interest.\n\nTool homepage: https://github.com/paulsengroup/StripePy"
inputs:
  - id: stripepy_hdf5
    type: File
    doc: Path to the .hdf5 generated by stripepy call.
    inputBinding:
      position: 101
  - id: output_name
    type: string
    doc: Path where to store the generated plot.
    inputBinding:
      position: 102
  - id: region
    type:
      - 'null'
      - string
    doc: Genomic region to be plotted (UCSC format); when not specified, a random 2.5Mb region is plotted
    inputBinding:
      position: 1
      prefix: --region
  - id: dpi
    type:
      - 'null'
      - int
    doc: DPI of the generated plot (default 300)
    inputBinding:
      position: 1
      prefix: --dpi
  - id: seed
    type:
      - 'null'
      - long
    doc: Seed for random number generation
    inputBinding:
      position: 1
      prefix: --seed
  - id: normalization
    type:
      - 'null'
      - string
    doc: Normalization to fetch
    inputBinding:
      position: 1
      prefix: --normalization
  - id: force
    type:
      - 'null'
      - boolean
    doc: Overwrite existing file(s)
    inputBinding:
      position: 1
      prefix: --force
  - id: verbosity
    type:
      - 'null'
      - string
    doc: Set verbosity of output to the console (debug, info, warning, error, critical; default info)
    inputBinding:
      position: 1
      prefix: --verbosity
outputs:
  - id: plot
    type: File
    doc: Generated plot
    outputBinding:
      glob: $(inputs.output_name)
requirements:
  - class: InlineJavascriptRequirement
hints:
  - class: DockerRequirement
    dockerPull: quay.io/biocontainers/stripepy-hic:1.3.0--pyh2a3209d_1
