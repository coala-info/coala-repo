cwlVersion: v1.2
class: CommandLineTool
baseCommand:
  - nanomonsv
  - merge_control
label: nanomonsv_merge_control
doc: "Merge control files generated by parse function\n\nTool homepage: https://github.com/friend1ws/nanomonsv"
inputs:
  - id: prefix_list_file
    type: File
    doc: Text file listing one prefix per line, the prefix of the parse step
      output of each control sample (the parse files must be given in
      parse_files so that the prefixes resolve in the working directory)
    inputBinding:
      position: 1
  - id: output_prefix
    type: string
    doc: Prefix of merged control files
    inputBinding:
      position: 2
  - id: parse_files
    type:
      type: array
      items: File
    doc: Output files of the parse step for every sample in prefix_list_file
      (<prefix>.*.sorted.bed.gz / .bedpe.gz with their .tbi indexes)
outputs:
  - id: merged_control_files
    type:
      type: array
      items: File
    doc: Merged control panel files written as <output_prefix>.*
    outputBinding:
      glob: $(inputs.output_prefix).*
  - id: stdout
    type: stdout
    doc: Standard output
requirements:
  - class: InitialWorkDirRequirement
    listing:
      - entry: $(inputs.parse_files)
hints:
  - class: DockerRequirement
    dockerPull: quay.io/biocontainers/nanomonsv:0.8.1--pyhdfd78af_0
stdout: nanomonsv_merge_control.out
