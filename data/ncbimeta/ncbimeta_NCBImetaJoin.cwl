cwlVersion: v1.2
class: CommandLineTool
baseCommand: [NCBImetaJoin]
label: ncbimeta_NCBImetaJoin
doc: "NCBImeta join tool: join accessory tables to an anchor table.\n\nTool homepage: https://github.com/ktmeaton/NCBImeta"
inputs:
  - id: database
    type: File
    doc: "Path to the sqlite database generated by NCBImeta."
    inputBinding:
      position: 1
      prefix: --database
  - id: anchor
    type: string
    doc: "Table in the NCBImeta database to use as an anchor for joining."
    inputBinding:
      position: 1
      prefix: --anchor
  - id: accessory
    type: string
    doc: "Accessory tables to join to the anchor as a space separated string, ex. 'BioProject Assembly'."
    inputBinding:
      position: 1
      prefix: --accessory
  - id: final
    type: string
    doc: "Name of the final table after the join."
    inputBinding:
      position: 1
      prefix: --final
  - id: unique
    type: string
    doc: "Column names in the anchor table to search for values in the accessory tables, ex. 'Accession BioProject'."
    inputBinding:
      position: 1
      prefix: --unique
outputs:
  - id: joined_database
    type: File
    doc: The modified sqlite database with the joined table.
    outputBinding:
      glob: $(inputs.database.basename)
  - id: stdout
    type: stdout
    doc: Standard output
stdout: NCBImetaJoin.stdout.txt
requirements:
  - class: InlineJavascriptRequirement
  - class: InitialWorkDirRequirement
    listing:
      - entry: $(inputs.database)
        writable: true
hints:
  - class: DockerRequirement
    dockerPull: quay.io/biocontainers/ncbimeta:0.8.3--pyhdfd78af_0
