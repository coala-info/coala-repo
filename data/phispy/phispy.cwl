cwlVersion: v1.2
class: CommandLineTool
baseCommand: phispy
label: phispy
doc: "PhiSpy is a tool for identifying prophages in bacterial genomes. It combines
  similarity searches and several statistical characteristics of prophage regions
  to identify prophages.\n\nTool homepage: https://github.com/linsalrob/PhiSpy"
inputs:
  - id: infile
    type: File
    doc: Input file in GenBank format
    inputBinding:
      position: 1
  - id: output_dir
    type: string
    doc: 'The output directory to write the results'
    inputBinding:
      position: 102
      prefix: --output_dir
  - id: make_training_data
    type:
      - 'null'
      - string
    doc: 'Create training data from a set of annotated genome files. Requires is_phage=1 qualifier in prophage''s CDSs'
    inputBinding:
      position: 102
      prefix: --make_training_data
  - id: training_set
    type:
      - 'null'
      - File
    doc: 'Choose the most closely related set to your genome. [Default data/trainSet_genericAll.txt]'
    inputBinding:
      position: 102
      prefix: --training_set
  - id: file_prefix
    type:
      - 'null'
      - string
    doc: 'An optional prefix to prepend to all of the output files'
    inputBinding:
      position: 102
      prefix: --file_prefix
  - id: evaluate
    type:
      - 'null'
      - boolean
    doc: 'Run in evaluation mode -- does not generate new data, but reruns the evaluation'
    inputBinding:
      position: 102
      prefix: --evaluate
  - id: number
    type:
      - 'null'
      - int
    doc: 'Number of consecutive genes in a region of window size that must be prophage genes to be called. [Default: 5]'
    inputBinding:
      position: 102
      prefix: --number
  - id: min_contig_size
    type:
      - 'null'
      - int
    doc: 'Minimum contig size (in bp) to be included in the analysis. Smaller contigs will be dropped. [Default: 5000]'
    inputBinding:
      position: 102
      prefix: --min_contig_size
  - id: window_size
    type:
      - 'null'
      - int
    doc: 'Window size of consecutive genes to look through to find phages. [Default: 30]'
    inputBinding:
      position: 102
      prefix: --window_size
  - id: nonprophage_genegaps
    type:
      - 'null'
      - int
    doc: 'The number of non phage genes betweeen prophages. [Default: 10]'
    inputBinding:
      position: 102
      prefix: --nonprophage_genegaps
  - id: phage_genes
    type:
      - 'null'
      - int
    doc: 'The minimum number of genes that must be identified as belonging to a phage for the region to be included. The default is 1 or more genes.'
    inputBinding:
      position: 102
      prefix: --phage_genes
  - id: metrics
    type:
      - 'null'
      - type: array
        items: string
    doc: 'The set of metrics to consider during classification. If not set, all metrics (orf_length_med, shannon_slope, at_skew, gc_skew, max_direction) will be considered.'
    inputBinding:
      position: 102
      prefix: --metrics
  - id: randomforest_trees
    type:
      - 'null'
      - int
    doc: 'Number of trees generated by Random Forest classifier. [Default: 500]'
    inputBinding:
      position: 102
      prefix: --randomforest_trees
  - id: expand_slope
    type:
      - 'null'
      - boolean
    doc: 'Use the product of the slope of the Shannon scores in making test sets'
    inputBinding:
      position: 102
      prefix: --expand_slope
  - id: kmers_type
    type:
      - 'null'
      - type: enum
        symbols:
          - all
          - codon
          - simple
    doc: 'Type of kmers used for calculating Shannon scores. [Default: all]'
    inputBinding:
      position: 102
      prefix: --kmers_type
  - id: phmms
    type:
      - 'null'
      - File
    doc: 'Phage HMM profile database (like pVOGs) will be mapped against the genome of interest and used as additional feature to identify prophages. Note that this is experimental at the moment'
    inputBinding:
      position: 102
      prefix: --phmms
  - id: include_annotations
    type:
      - 'null'
      - boolean
    doc: 'Use the annotations in the GenBank file in the phage predictions (default)'
    inputBinding:
      position: 102
      prefix: --include_annotations
  - id: ignore_annotations
    type:
      - 'null'
      - boolean
    doc: 'Ignore the annotations in the GenBank file during predictions'
    inputBinding:
      position: 102
      prefix: --ignore_annotations
  - id: color
    type:
      - 'null'
      - boolean
    doc: 'If set, within the output GenBank file CDSs with phmms hits will be colored (for viewing in Artemis).'
    inputBinding:
      position: 102
      prefix: --color
  - id: threads
    type:
      - 'null'
      - int
    doc: 'Number of threads to use while searching with phmms and the random forest. [default: 2]'
    inputBinding:
      position: 102
      prefix: --threads
  - id: output_choice
    type:
      - 'null'
      - int
    doc: 'Sum of codes for files to output. For more details see the README.md file at https://github.com/linsalrob/PhiSpy#choosing-which-output-files-are-created. [default: 3]'
    inputBinding:
      position: 102
      prefix: --output_choice
  - id: include_all_repeats
    type:
      - 'null'
      - boolean
    doc: 'include all repeats in the genbank output'
    inputBinding:
      position: 102
      prefix: --include_all_repeats
  - id: keep_dropped_predictions
    type:
      - 'null'
      - boolean
    doc: 'Write regions that might be prophages to the output files'
    inputBinding:
      position: 102
      prefix: --keep_dropped_predictions
  - id: extra_dna
    type:
      - 'null'
      - int
    doc: 'additional DNA flanking the predicted prophage to test for repeats [Default 2000]'
    inputBinding:
      position: 102
      prefix: --extra_dna
  - id: min_repeat_len
    type:
      - 'null'
      - int
    doc: 'minimum repeat length to search for [Default: 10]'
    inputBinding:
      position: 102
      prefix: --min_repeat_len
  - id: log
    type:
      - 'null'
      - string
    doc: 'Name of the log file to write details to [Default: phispy.log]'
    inputBinding:
      position: 102
      prefix: --log
  - id: quiet
    type:
      - 'null'
      - boolean
    doc: 'Run in quiet mode'
    inputBinding:
      position: 102
      prefix: --quiet
  - id: keep
    type:
      - 'null'
      - boolean
    doc: 'Do not delete temp files'
    inputBinding:
      position: 102
      prefix: --keep
outputs:
  - id: out_output_dir
    type: Directory
    doc: The output directory with the prophage predictions
    outputBinding:
      glob: $(inputs.output_dir)
hints:
  - class: DockerRequirement
    dockerPull: quay.io/biocontainers/phispy:4.2.21--py39h2de1943_8
