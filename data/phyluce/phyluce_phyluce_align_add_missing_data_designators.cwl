cwlVersion: v1.2
class: CommandLineTool
baseCommand: [phyluce_align_add_missing_data_designators]
label: phyluce_phyluce_align_add_missing_data_designators
doc: "Add missing data designators to a set of incomplete alignments.\n\nTool homepage: https://github.com/faircloth-lab/phyluce"
inputs:
  - id: alignments
    type: Directory
    doc: "Directory of alignment files to process."
    inputBinding:
      position: 1
      prefix: --alignments
  - id: output
    type: string
    doc: "The output dir in which to store copies of the alignments."
    inputBinding:
      position: 2
      prefix: --output
  - id: match_count_output
    type: File
    doc: "The output file containing taxa and loci in complete/incomplete matrices generated by get_match_counts.py."
    inputBinding:
      position: 3
      prefix: --match-count-output
  - id: incomplete_matrix
    type: ['null', File]
    doc: "The output file for incomplete-matrix records generated by get_match_counts.py."
    inputBinding:
      position: 4
      prefix: --incomplete-matrix
  - id: min_taxa
    type: ['null', int]
    doc: "The minimum number of taxa to keep (default: 3)."
    inputBinding:
      position: 5
      prefix: --min-taxa
  - id: missing_character
    type: ['null', string]
    doc: "The character to use for missing data (default: ?)."
    inputBinding:
      position: 6
      prefix: --missing-character
  - id: verbatim
    type: ['null', boolean]
    doc: "Do not parse species names at all - use them verbatim."
    inputBinding:
      position: 7
      prefix: --verbatim
  - id: input_format
    type: ['null', string]
    doc: "The input alignment format. One of: fasta, nexus, phylip, clustal, emboss, stockholm (default: nexus)."
    inputBinding:
      position: 8
      prefix: --input-format
  - id: output_format
    type: ['null', string]
    doc: "The output alignment format. One of: fasta, nexus, phylip, clustal, emboss, stockholm (default: nexus)."
    inputBinding:
      position: 9
      prefix: --output-format
  - id: no_check_missing
    type: ['null', boolean]
    doc: "Do not check the list of missing loci."
    inputBinding:
      position: 10
      prefix: --no-check-missing
  - id: verbosity
    type: ['null', string]
    doc: "The logging level to use (INFO, WARN, CRITICAL)."
    inputBinding:
      position: 11
      prefix: --verbosity
  - id: log_path
    type: ['null', string]
    doc: "The path to an existing directory to hold logs."
    inputBinding:
      position: 12
      prefix: --log-path
  - id: cores
    type: ['null', int]
    doc: "Process alignments in parallel using --cores for alignment. This is the number of PHYSICAL CPUs."
    inputBinding:
      position: 13
      prefix: --cores
outputs:
  - id: output_dir
    type: Directory
    doc: "Directory of alignments with missing data designators added."
    outputBinding:
      glob: "$(inputs.output)"
hints:
  - class: DockerRequirement
    dockerPull: quay.io/biocontainers/phyluce:1.6.8--py_0
