cwlVersion: v1.2
class: CommandLineTool
baseCommand:
  - clair.py
  - evaluate
label: clair_evaluate
doc: "Evaluate trained model\n\nTool homepage: https://github.com/HKU-BAL/Clair"
inputs:
  - id: bin_fn
    type:
      - 'null'
      - File
    doc: "Binary tensor input generated by tensor2Bin.py, tensor_fn, var_fn and bed_fn will be ignored"
    inputBinding:
      position: 101
      prefix: --bin_fn
  - id: train_bin_fn
    type:
      - 'null'
      - File
    doc: "Train Binary, used together with --validation_bin_fn"
    inputBinding:
      position: 101
      prefix: --train_bin_fn
  - id: validation_bin_fn
    type:
      - 'null'
      - File
    doc: "Validation Binary, used together with --train_bin_fn"
    inputBinding:
      position: 101
      prefix: --validation_bin_fn
  - id: tensor_fn
    type:
      - 'null'
      - File
    doc: "Tensor input"
    inputBinding:
      position: 101
      prefix: --tensor_fn
  - id: var_fn
    type:
      - 'null'
      - File
    doc: "Truth variants list input"
    inputBinding:
      position: 101
      prefix: --var_fn
  - id: bed_fn
    type:
      - 'null'
      - File
    doc: "High confident genome regions input in the BED format"
    inputBinding:
      position: 101
      prefix: --bed_fn
  - id: chkpnt_fn
    type: File
    doc: "Input a checkpoint for testing, REQUIRED: Trained model checkpoint: give the .index file of the model; the checkpoint prefix (path without .index) is passed, with the .meta and .data-00000-of-00001 files beside it"
    secondaryFiles:
      - pattern: "^.meta"
        required: true
      - pattern: "^.data-00000-of-00001"
        required: true
    inputBinding:
      position: 101
      prefix: --chkpnt_fn
      valueFrom: "$(self.path.replace(/\\.index$/, ''))"
outputs:
  - id: stdout
    type: stdout
    doc: Standard output
  - id: stderr
    type: stderr
    doc: Standard error (evaluation report)
requirements:
  - class: InlineJavascriptRequirement
hints:
  - class: DockerRequirement
    dockerPull: quay.io/biocontainers/clair:2.1.1--hdfd78af_1
stdout: clair_evaluate.out
stderr: clair_evaluate.err
