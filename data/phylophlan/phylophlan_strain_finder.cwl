cwlVersion: v1.2
class: CommandLineTool
baseCommand:
  - phylophlan_strain_finder
label: phylophlan_strain_finder
doc: "Analyzes the phylogeny and the mutation rates table generated by phylophlan and returns sub-trees representing the same strain, according to a phylogenetic threshold and a mutation rate threshold.\n\nTool homepage: https://github.com/biobakery/phylophlan"
inputs:
  - id: input
    type: File
    doc: "The phylogenetic tree as generated by phylophlan"
    inputBinding:
      position: 1
      prefix: "--input"
  - id: mutation_rates
    type: File
    doc: "The mutation rates table as generated by phylophlan (--mutation_rates)"
    inputBinding:
      position: 2
      prefix: "--mutation_rates"
  - id: phylo_thr
    type:
      - 'null'
      - float
    doc: "Maximum phylogenetic distance threshold for every pair of nodes in the same subtree (inclusive). Default: 0.05"
    inputBinding:
      position: 3
      prefix: "--phylo_thr"
  - id: mutrate_thr
    type:
      - 'null'
      - float
    doc: "Maximum mutation rate ratio for every pair of nodes in the same subtree (inclusive). Default: 0.05"
    inputBinding:
      position: 3
      prefix: "--mutrate_thr"
  - id: tree_format
    type:
      - 'null'
      - string
    doc: "Format of the input tree (newick, nexus, phyloxml, cdao or nexml). Default: newick"
    inputBinding:
      position: 3
      prefix: "--tree_format"
  - id: output
    type: string
    doc: "Output filename (the tool writes to standard output when not given)"
    default: "strain_finder.tsv"
    inputBinding:
      position: 3
      prefix: "--output"
  - id: overwrite
    type:
      - 'null'
      - boolean
    doc: "Overwrite the output file if exists"
    inputBinding:
      position: 3
      prefix: "--overwrite"
  - id: separator
    type:
      - 'null'
      - string
    doc: "Separator to use in the output (; , or tab)"
    inputBinding:
      position: 3
      prefix: "--separator"
  - id: verbose
    type:
      - 'null'
      - boolean
    doc: "Write more stuff"
    inputBinding:
      position: 3
      prefix: "--verbose"
outputs:
  - id: strains
    type:
      - 'null'
      - File
    doc: "Sub-trees representing the same strain"
    outputBinding:
      glob: "$(inputs.output)"
  - id: stdout
    type: stdout
    doc: "Standard output"
requirements:
  - class: InlineJavascriptRequirement
hints:
  - class: DockerRequirement
    dockerPull: quay.io/biocontainers/phylophlan:3.2.1--pyhdfd78af_0
stdout: phylophlan_strain_finder.out
