cwlVersion: v1.2
class: CommandLineTool
baseCommand: add_pangenome_matrices.pl
label: get_homologues_add_pangenome_matrices.pl
doc: "Adds two pangenome matrices (-m files) generated by compare_clusters.pl, for instance to combine CDS and -a 'rRNA,tRNA' results.\n\nTool homepage: https://github.com/eead-csic-compbio/get_homologues"
inputs:
  - id: first_tab_file
    type: File
    doc: first input .tab data file (generated by compare_clusters.pl)
    inputBinding:
      position: 1
      prefix: -i
  - id: second_tab_file
    type: File
    doc: second input .tab data file (generated by compare_clusters.pl)
    inputBinding:
      position: 2
      prefix: -j
  - id: output_tab_file
    type: string
    doc: name of output .tab file
    default: pangenome_sum.tab
    inputBinding:
      position: 3
      prefix: -o
outputs:
  - id: output_matrix
    type: File
    doc: Output pangenome matrix .tab file with the clusters of both inputs side by side.
    outputBinding:
      glob: $(inputs.output_tab_file)
  - id: stdout
    type: stdout
    doc: Standard output
stdout: get_homologues_add_pangenome_matrices.pl.out
hints:
  - class: DockerRequirement
    dockerPull: quay.io/biocontainers/get_homologues:3.8.1--hdfd78af_0
