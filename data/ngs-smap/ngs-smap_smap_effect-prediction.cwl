cwlVersion: v1.2
class: CommandLineTool
baseCommand:
  - smap
  - effect-prediction
label: ngs-smap_smap_effect-prediction
doc: "\n\nTool homepage: https://gitlab.com/truttink/smap"
inputs:
  - id: frequency_table
    type: File
    doc: "Tab-delimited file containing haplotype frequencies per locus, as generated by SMAP haplotype-window."
    inputBinding:
      position: 1
  - id: genome
    type: File
    doc: "Reference genome sequence (in .fasta format) onto which the .fastq files were mapped."
    inputBinding:
      position: 2
  - id: borders
    type: File
    doc: ".gff file containing the border coordinates, must contain NAME=<> in column 9."
    inputBinding:
      position: 3
  - id: gene_annotation
    type:
      - 'null'
      - File
    doc: ".gff file containing the gene and CDS annotation. Must be provided unless you use --disable_protein_prediction."
    inputBinding:
      position: 10
      prefix: --gene_annotation
  - id: debug
    type:
      - 'null'
      - boolean
    doc: "Enable verbose logging."
    inputBinding:
      position: 10
      prefix: --debug
  - id: gRNAs
    type:
      - 'null'
      - File
    doc: ".gff file containing the gRNA coordinates, must contain NAME=<> in column 9."
    inputBinding:
      position: 10
      prefix: --gRNAs
  - id: no_gRNA_relative_naming
    type:
      - 'null'
      - boolean
    doc: ".gff file containing the gRNA coordinates, must contain NAME=<> in column 9."
    inputBinding:
      position: 10
      prefix: --no_gRNA_relative_naming
  - id: cas_protein
    type:
      - 'null'
      - string
    doc: "Name of the nucluease used in the experiment. Used to select a predefined offset."
    inputBinding:
      position: 10
      prefix: --cas_protein
  - id: cas_offset
    type:
      - 'null'
      - int
    doc: "Cas offset"
    inputBinding:
      position: 10
      prefix: --cas_offset
  - id: cut_site_range_upper_bound
    type:
      - 'null'
      - int
    doc: "Upper bound for selecting variations from a range around the cut site. Defined in the direction from the cut-site towards the PAM."
    inputBinding:
      position: 10
      prefix: --cut_site_range_upper_bound
  - id: cut_site_range_lower_bound
    type:
      - 'null'
      - int
    doc: "Lower bound for selecting variations from the a range around the cut site. Defined in the direction from the cut-site towards the start of the gRNA binding site."
    inputBinding:
      position: 10
      prefix: --cut_site_range_lower_bound
  - id: cpu
    type:
      - 'null'
      - int
    doc: "Maximum number of allowed processes."
    inputBinding:
      position: 10
      prefix: --cpu
  - id: match_score
    type:
      - 'null'
      - int
    doc: ""
    inputBinding:
      position: 10
      prefix: --match_score
  - id: mismatch_penalty
    type:
      - 'null'
      - int
    doc: ""
    inputBinding:
      position: 10
      prefix: --mismatch_penalty
  - id: gap_open_penalty
    type:
      - 'null'
      - int
    doc: ""
    inputBinding:
      position: 10
      prefix: --gap_open_penalty
  - id: gap_extension
    type:
      - 'null'
      - int
    doc: ""
    inputBinding:
      position: 10
      prefix: --gap_extension
  - id: discrete_calls
    type:
      - 'null'
      - string
    doc: "Set to \"dominant\" to transform haplotype frequency values into presence(1)/absence(0) calls per allele, or \"dosage\" to indicate the allele copy number."
    inputBinding:
      position: 10
      prefix: --discrete_calls
  - id: frequency_interval_bounds
    type:
      - 'null'
      - type: array
        items: string
    doc: "Frequency interval bounds for transforming haplotype frequencies into discrete calls. Custom thresholds can be defined by passing one or more space-separated values (relative frequencies in percentage). For dominant calling, one value should be specified. For dosage calling, an even total number of four or more thresholds should be specified. Default values are invoked by passing either \"diploid\" or \"tetraploid\". The default value for dominant calling (see discrete_calls argument) is 10, both for \"diploid\" and \"tetraploid\". For dosage calling, the default for diploids is \"10, 10, 90, 90\" and for tetraploids \"12.5, 12.5, 37.5, 37.5, 62.5, 62.5, 87.5, 87.5\"."
    inputBinding:
      position: 10
      prefix: --frequency_interval_bounds
  - id: disable_protein_prediction
    type:
      - 'null'
      - boolean
    doc: "Disable the estimation of the protein from the haplotypes sequences. All variations within range (-s and -r) of the cut-site will be considered as relevant sequence variant with an effect. This option requires --gRNAs."
    inputBinding:
      position: 10
      prefix: --disable_protein_prediction
  - id: effect_threshold
    type:
      - 'null'
      - float
    doc: "Threshold to determine whether a protein is affected by the haplotype variant sequence or not. For each haplotype, a protein identity score is calculated compared to the reference. Haplotypes for which the protein identity is below the effect threshold, will be marked as encoding an affected protein.For instance, a protein with 10% identity to the reference, is below an effect threshold of 50%, and will be marked as loss-of-function (LOF)."
    inputBinding:
      position: 10
      prefix: --effect_threshold
outputs:
  - id: output_files
    type:
      type: array
      items: File
    doc: "Effect prediction tables written by SMAP effect-prediction"
    outputBinding:
      glob:
        - "*.tsv"
        - "*.gff"
        - "*.png"
        - "*.pdf"
        - "*.txt"
        - "*.fasta"
requirements:
  - class: InlineJavascriptRequirement
hints:
  - class: DockerRequirement
    dockerPull: quay.io/biocontainers/ngs-smap:5.0.1--pyhdfd78af_0
