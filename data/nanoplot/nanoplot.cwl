cwlVersion: v1.2
class: CommandLineTool
baseCommand: NanoPlot
label: nanoplot
doc: "Plotting tool for long-read sequencing data and alignments.\n\nTool homepage:
  https://github.com/wdecoster/NanoPlot"
inputs:
  - id: bam
    type:
      - 'null'
      - type: array
        items: File
    secondaryFiles:
      - pattern: .bai
        required: false
    doc: Input BAM file(s)
    inputBinding:
      position: 101
      prefix: --bam
  - id: drop_outliers
    type:
      - 'null'
      - boolean
    doc: Drop outliers (top 5%) from the plots
    inputBinding:
      position: 101
      prefix: --drop_outliers
  - id: fasta
    type:
      - 'null'
      - type: array
        items: File
    doc: Input FASTA file(s)
    inputBinding:
      position: 101
      prefix: --fasta
  - id: fastq
    type:
      - 'null'
      - type: array
        items: File
    doc: Input FASTQ file(s)
    inputBinding:
      position: 101
      prefix: --fastq
  - id: format
    type:
      - 'null'
      - string
    doc: Specify the output format of the plots (png, jpg, svg, pdf, html, etc.)
    inputBinding:
      position: 101
      prefix: --format
  - id: loglength
    type:
      - 'null'
      - boolean
    doc: Logarithmic transformation of length axis
    inputBinding:
      position: 101
      prefix: --loglength
  - id: maxlength
    type:
      - 'null'
      - int
    doc: Hide reads longer than the specified length
    inputBinding:
      position: 101
      prefix: --maxlength
  - id: minlength
    type:
      - 'null'
      - int
    doc: Hide reads shorter than the specified length
    inputBinding:
      position: 101
      prefix: --minlength
  - id: minqual
    type:
      - 'null'
      - int
    doc: Hide reads with an average quality score lower than the specified value
    inputBinding:
      position: 101
      prefix: --minqual
  - id: prefix
    type:
      - 'null'
      - string
    doc: Specify a prefix for the output filenames
    inputBinding:
      position: 101
      prefix: --prefix
  - id: summary
    type:
      - 'null'
      - File
    doc: Statistically summarize the sequencing run using a 
      sequencing_summary.txt file from Albacore/Guppy
    inputBinding:
      position: 101
      prefix: --summary
  - id: threads
    type:
      - 'null'
      - int
    doc: Set the allowed number of threads to be used by the script
    inputBinding:
      position: 101
      prefix: --threads
  - id: title
    type:
      - 'null'
      - string
    doc: Add a title to the plots
    inputBinding:
      position: 101
      prefix: --title
  - id: n50_show
    type:
      - 'null'
      - boolean
    doc: Show the N50 mark in the read length histogram
    inputBinding:
      position: 101
      prefix: --N50
  - id: no_n50
    type:
      - 'null'
      - boolean
    doc: Hide the N50 mark in the read length histogram
    inputBinding:
      position: 101
      prefix: --no-N50
  - id: alength
    type:
      - 'null'
      - boolean
    doc: Use aligned read lengths rather than sequenced length (bam mode)
    inputBinding:
      position: 101
      prefix: --alength
  - id: barcoded
    type:
      - 'null'
      - boolean
    doc: Use if you want to split the summary file by barcode
    inputBinding:
      position: 101
      prefix: --barcoded
  - id: colormap
    type:
      - 'null'
      - string
    doc: Specify a valid matplotlib colormap for the heatmap
    inputBinding:
      position: 101
      prefix: --colormap
  - id: color
    type:
      - 'null'
      - string
    doc: Specify a valid matplotlib color for the plots
    inputBinding:
      position: 101
      prefix: --color
  - id: cram
    type:
      - 'null'
      - type: array
        items: File
    secondaryFiles:
      - pattern: .crai
        required: false
    doc: Data is in one or more sorted cram file(s).
    inputBinding:
      position: 101
      prefix: --cram
  - id: dpi
    type:
      - 'null'
      - int
    doc: Set the dpi for saving images
    inputBinding:
      position: 101
      prefix: --dpi
  - id: fastq_rich
    type:
      - 'null'
      - type: array
        items: File
    doc: Data is in one or more fastq file(s) generated by albacore, MinKNOW or guppy with additional information concerning channel and time.
    inputBinding:
      position: 101
      prefix: --fastq_rich
  - id: fastq_minimal
    type:
      - 'null'
      - type: array
        items: File
    doc: Data is in one or more fastq file(s) generated by albacore, MinKNOW or guppy with additional information concerning channel and time. Is extracted swiftly without elaborate checks.
    inputBinding:
      position: 101
      prefix: --fastq_minimal
  - id: feather
    type:
      - 'null'
      - type: array
        items: File
    doc: Data is in one or more feather file(s).
    inputBinding:
      position: 101
      prefix: --feather
  - id: font_scale
    type:
      - 'null'
      - float
    doc: Scale the font of the plots by a factor
    inputBinding:
      position: 101
      prefix: --font_scale
  - id: hide_stats
    type:
      - 'null'
      - boolean
    doc: Not adding Pearson R stats in some bivariate plots
    inputBinding:
      position: 101
      prefix: --hide_stats
  - id: huge
    type:
      - 'null'
      - boolean
    doc: Input data is one very large file.
    inputBinding:
      position: 101
      prefix: --huge
  - id: info_in_report
    type:
      - 'null'
      - boolean
    doc: Add NanoPlot run info in the report.
    inputBinding:
      position: 101
      prefix: --info_in_report
  - id: no_static
    type:
      - 'null'
      - boolean
    doc: Do not make static (png) plots.
    inputBinding:
      position: 101
      prefix: --no_static
  - id: no_supplementary
    type:
      - 'null'
      - boolean
    doc: Use if you want to remove supplementary alignments
    inputBinding:
      position: 101
      prefix: --no_supplementary
  - id: only_report
    type:
      - 'null'
      - boolean
    doc: Output only the report
    inputBinding:
      position: 101
      prefix: --only-report
  - id: percentqual
    type:
      - 'null'
      - boolean
    doc: Use qualities as theoretical percent identities.
    inputBinding:
      position: 101
      prefix: --percentqual
  - id: plots
    type:
      - 'null'
      - type: array
        items: string
    doc: Specify which bivariate plots have to be made (kde, hex, dot).
    inputBinding:
      position: 101
      prefix: --plots
  - id: legacy
    type:
      - 'null'
      - type: array
        items: string
    doc: Specify which bivariate plots have to be made (legacy mode; kde, dot, hex).
    inputBinding:
      position: 101
      prefix: --legacy
  - id: downsample
    type:
      - 'null'
      - int
    doc: Reduce dataset to N reads by random sampling.
    inputBinding:
      position: 101
      prefix: --downsample
  - id: raw
    type:
      - 'null'
      - boolean
    doc: Store the extracted data in tab separated file.
    inputBinding:
      position: 101
      prefix: --raw
  - id: readtype
    type:
      - 'null'
      - string
    doc: Which read type to extract information about from summary. Options are 1D, 2D, 1D2
    inputBinding:
      position: 101
      prefix: --readtype
  - id: runtime_until
    type:
      - 'null'
      - int
    doc: Only take the N first hours of a run
    inputBinding:
      position: 101
      prefix: --runtime_until
  - id: store
    type:
      - 'null'
      - boolean
    doc: Store the extracted data in a pickle file for future plotting.
    inputBinding:
      position: 101
      prefix: --store
  - id: tsv_stats
    type:
      - 'null'
      - boolean
    doc: Output the stats file as a properly formatted TSV.
    inputBinding:
      position: 101
      prefix: --tsv_stats
  - id: pickle
    type:
      - 'null'
      - File
    doc: Data is a pickle file stored earlier.
    inputBinding:
      position: 101
      prefix: --pickle
  - id: verbose
    type:
      - 'null'
      - boolean
    doc: Write log messages also to terminal.
    inputBinding:
      position: 101
      prefix: --verbose
  - id: ubam
    type:
      - 'null'
      - type: array
        items: File
    doc: Data is in an unmapped bam file
    inputBinding:
      position: 101
      prefix: --ubam
  - id: outdir_path
    type: string
    doc: Output or path parameter `outdir_path`
    inputBinding:
      position: 102
      prefix: --outdir
outputs:
  - id: outdir
    type:
      - 'null'
      - Directory
    doc: Directory to deposit the results
    outputBinding:
      glob: $(inputs.outdir_path)
requirements:
  - class: InlineJavascriptRequirement
hints:
  - class: DockerRequirement
    dockerPull: quay.io/biocontainers/nanoplot:1.46.2--pyhdfd78af_0
