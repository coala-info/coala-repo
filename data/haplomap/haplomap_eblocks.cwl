cwlVersion: v1.2
class: CommandLineTool
baseCommand:
  - haplomap
  - eblocks
label: haplomap_eblocks
doc: "Find all maximal haploblocks\n\nTool homepage: https://github.com/zqfang/haplomap"
inputs:
  - id: alleles_file
    type: File
    doc: "The file generated by (haplomap convert)"
    inputBinding:
      position: 1
      prefix: --alleles
  - id: block_variant_path
    type:
      - 'null'
      - string
    doc: "Output variants coordinates, used for viewing variants in a certain haploblocks"
    inputBinding:
      position: 1
      prefix: --block-variant
  - id: genes_file
    type: File
    doc: "SNPs-to-genes annotation file, the file generated by (haplomap annotate)"
    inputBinding:
      position: 1
      prefix: --genes
  - id: min_variants_per_block
    type:
      - 'null'
      - int
    doc: "Minimum variants per block. Default 3."
    inputBinding:
      position: 1
      prefix: --minblock-variant
  - id: non_overlapping
    type:
      - 'null'
      - boolean
    doc: "Run non-overlapping haploblock finding algorthim"
    inputBinding:
      position: 1
      prefix: --non-overlapping
  - id: reference_genome
    type:
      - 'null'
      - string
    doc: "Name of the reference strain, one of the strain names from the header of the alleles file. Default: C57BL/6J."
    inputBinding:
      position: 1
      prefix: --reference
  - id: strains_file
    type: File
    doc: "Strains file, the same input file as (haplomap ghmap -p)"
    inputBinding:
      position: 1
      prefix: --strains
  - id: verbose
    type:
      - 'null'
      - boolean
    doc: "verbose"
    inputBinding:
      position: 1
      prefix: --verbose
  - id: output_file_path
    type: string
    doc: "Output haploblocks file, input for (haplomap ghmap -b)"
    inputBinding:
      position: 1
      prefix: --output
outputs:
  - id: output_file
    type: File
    doc: "Haploblocks file"
    outputBinding:
      glob: $(inputs.output_file_path)
  - id: block_variant_file
    type:
      - 'null'
      - File
    doc: "Variant coordinates of the haploblocks, written with --block-variant"
    outputBinding:
      glob: $(inputs.block_variant_path)
hints:
  - class: DockerRequirement
    dockerPull: quay.io/biocontainers/haplomap:0.1.2--h4656aac_1
