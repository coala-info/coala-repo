cwlVersion: v1.2
class: CommandLineTool
baseCommand: strainscan_build
label: strainscan_strainscan_build
doc: "StrainScan - A kmer-based strain-level identification tool. strainscan_build builds the database (clusters and k-mer sets) from a directory of strain genomes.\n\nTool homepage: https://github.com/liaoherui/StrainScan"
inputs:
  - id: input_fasta
    type: Directory
    doc: "The dir of input fasta genome (gzipped fasta is accepted)"
    inputBinding:
      position: 100
      prefix: --input_fasta
  - id: output_dir
    type: string
    doc: "Output directory (database)"
    default: StrainScan_DB
    inputBinding:
      position: 102
      prefix: --output_dir
  - id: cls_file
    type:
      - 'null'
      - File
    doc: "The custom clustering file provided by user."
    inputBinding:
      position: 101
      prefix: --cls_file
  - id: kmer_size
    type:
      - 'null'
      - int
    doc: "The size of kmer, should be odd number. (default 31)"
    inputBinding:
      position: 101
      prefix: --kmer_size
  - id: threads
    type:
      - 'null'
      - int
    doc: "The threads used to build the database. (default 1)"
    inputBinding:
      position: 101
      prefix: --threads
  - id: uk_num
    type:
      - 'null'
      - int
    doc: "The maximum number of unique k-mers in each genome to extract. (default 100000)"
    inputBinding:
      position: 101
      prefix: --uk_num
  - id: gk_ratio
    type:
      - 'null'
      - float
    doc: "The ratio of group-specific k-mers to extract. (default 1.0)"
    inputBinding:
      position: 101
      prefix: --gk_ratio
  - id: strainest_sample
    type:
      - 'null'
      - int
    doc: "If this parameter is 1, then the program will search joint kmer sets from msa generated by Strainest. (default 0)"
    inputBinding:
      position: 101
      prefix: --strainest_sample
  - id: memory_efficient
    type:
      - 'null'
      - int
    doc: "If this parameter is 1, then the program will build the database with the memory efficient mode. (default 0)"
    inputBinding:
      position: 101
      prefix: --memory_efficient
  - id: mink_cutoff
    type:
      - 'null'
      - int
    doc: "Minimum k-mer number cutoff in a node. (default 1000)"
    inputBinding:
      position: 101
      prefix: --mink_cutoff
  - id: maxk_cutoff
    type:
      - 'null'
      - int
    doc: "Maximum k-mer number cutoff in a node (default 30000)"
    inputBinding:
      position: 101
      prefix: --maxk_cutoff
  - id: maxn_cutoff
    type:
      - 'null'
      - int
    doc: "Maximum cluster number for node reconstruction. (default 3000)"
    inputBinding:
      position: 101
      prefix: --maxn_cutoff
outputs:
  - id: output_dir_dir
    type: Directory
    doc: Database directory
    outputBinding:
      glob: $(inputs.output_dir)
hints:
  - class: DockerRequirement
    dockerPull: quay.io/biocontainers/strainscan:1.0.14--pyhdfd78af_1
