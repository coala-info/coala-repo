cwlVersion: v1.2
class: CommandLineTool
baseCommand: checkTableCoords
label: ucsc-checktablecoords
doc: "Check invariants on genomic coordinates in table(s). Searches for illegal genomic
  coordinates in all tables of a database unless narrowed down using options. Uses
  ~/.hg.conf to determine the genome database connection; the hg_conf input is staged
  as .hg.conf in the working directory (the home directory of the tool). For psl/alignment
  tables, checks target coordinates only.\n\nTool homepage: https://hgdownload.cse.ucsc.edu/admin/exe"
requirements:
  - class: NetworkAccess
    networkAccess: true
  - class: InitialWorkDirRequirement
    listing:
      - entryname: .hg.conf
        entry: $(inputs.hg_conf)
inputs:
  - id: hg_conf
    type: File
    doc: 'Genome database connection file, staged as ~/.hg.conf (for the public UCSC
      server: db.host=genome-mysql.soe.ucsc.edu, db.user=genome, db.password=)'
  - id: database
    type: string
    doc: Name of the genome database (for example hg19)
    inputBinding:
      position: 1
  - id: table_name
    type: ['null', string]
    doc: Table to check
    inputBinding:
      position: 2
  - id: table
    type: ['null', string]
    doc: Check this table only (default is all tables)
    inputBinding:
      position: 0
      prefix: -table=
      separate: false
  - id: days_old
    type: ['null', int]
    doc: Check tables that have been modified at most N days ago
    inputBinding:
      position: 0
      prefix: -daysOld=
      separate: false
  - id: hours_old
    type: ['null', int]
    doc: Check tables that have been modified at most N hours ago (days and hours
      are additive)
    inputBinding:
      position: 0
      prefix: -hoursOld=
      separate: false
  - id: exclude
    type: ['null', string]
    doc: Exclude tables matching any pattern in this comma-separated list. Patterns
      can contain wildcards (*?) and the word genbank, which expands to all tables
      generated by the automated genbank build process
    inputBinding:
      position: 0
      prefix: -exclude=
      separate: false
  - id: ignore_blocks
    type: ['null', boolean]
    doc: To save time (but lose coverage), skip block coordinate checks
    inputBinding:
      position: 0
      prefix: -ignoreBlocks
  - id: verbose_blocks
    type: ['null', boolean]
    doc: Print out more details about illegal block coordinates
    inputBinding:
      position: 0
      prefix: -verboseBlocks
outputs:
  - id: stdout
    type: stdout
    doc: Report of illegal coordinates (empty when none are found)
hints:
  - class: DockerRequirement
    dockerPull: quay.io/biocontainers/ucsc-checktablecoords:482--h0b57e2e_0
stdout: ucsc-checktablecoords.out
