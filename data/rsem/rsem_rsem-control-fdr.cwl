cwlVersion: v1.2
class: CommandLineTool
baseCommand: [rsem-control-fdr]
label: rsem_rsem-control-fdr
doc: "Filter the EBSeq output of rsem-run-ebseq for statistical significance at a given false discovery rate.\n\nTool homepage: https://deweylab.github.io/RSEM/"
inputs:
  - id: hard_threshold
    type: ['null', boolean]
    doc: Use the hard threshold method; only genes/transcripts with PPDE >= 1 - fdr_rate are called as DE. (Default - on)
    inputBinding:
      position: 1
      prefix: --hard-threshold
  - id: soft_threshold
    type: ['null', boolean]
    doc: Use the soft threshold method (EBSeq crit_fun); report as many genes/transcripts as possible while their average PPDE >= 1 - fdr_rate. (Default - off)
    inputBinding:
      position: 1
      prefix: --soft-threshold
  - id: input_file
    type: File
    doc: Main result file generated by rsem-run-ebseq.
    inputBinding:
      position: 2
  - id: fdr_rate
    type: float
    doc: The desired false discovery rate.
    inputBinding:
      position: 3
  - id: output_file
    type: string
    doc: Output file; the subset of input_file called as differentially expressed.
    inputBinding:
      position: 4
outputs:
  - id: de_results
    type: File
    doc: Genes/transcripts called as differentially expressed.
    outputBinding:
      glob: $(inputs.output_file)
hints:
  - class: DockerRequirement
    dockerPull: quay.io/biocontainers/rsem:1.3.3--pl5321h077b44d_12
