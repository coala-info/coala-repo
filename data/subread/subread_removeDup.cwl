cwlVersion: v1.2
class: CommandLineTool
baseCommand: removeDup
label: subread_removeDup
doc: "Remove duplicated reads.\n\nTool homepage: http://subread.sourceforge.net/"
inputs:
  - id: input_file
    type: File
    doc: Name of input file in SAM/BAM format.
    inputBinding:
      position: 1
      prefix: -i
  - id: output_file
    type: string
    doc: Name of output file including filtered reads. The format is BAM unless -S is specified.
    inputBinding:
      position: 1
      prefix: -o
  - id: sam_output
    type:
      - 'null'
      - boolean
    doc: Generate the SAM format output.
    inputBinding:
      position: 1
      prefix: -S
  - id: duplication_cutoff
    type:
      - 'null'
      - int
    doc: Duplication cutoff. All the reads mapped to a location are removed from the output if the number of reads mapped to this location is equal or higher than the cutoff. 10 by default.
    inputBinding:
      position: 1
      prefix: -r
  - id: temp_dir
    type:
      - 'null'
      - string
    doc: A directory storing temporary files generated by the program.
    inputBinding:
      position: 1
      prefix: -t
outputs:
  - id: filtered
    type: File
    doc: Reads after duplicate removal
    outputBinding:
      glob: $(inputs.output_file)
requirements:
  - class: InlineJavascriptRequirement
hints:
  - class: DockerRequirement
    dockerPull: quay.io/biocontainers/subread:2.1.1--h577a1d6_0
