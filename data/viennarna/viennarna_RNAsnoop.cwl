cwlVersion: v1.2
class: CommandLineTool
baseCommand:
  - RNAsnoop
label: viennarna_RNAsnoop
doc: |-
  Find targets of a query H/ACA snoRNA.

  Tool homepage: https://www.tbi.univie.ac.at/RNA/
inputs:
  - id: verbose
    type:
      - 'null'
      - boolean
    doc: Be verbose.
    inputBinding:
      position: 10
      prefix: --verbose
  - id: query
    type: File
    doc: File containing the query sequence.
    inputBinding:
      position: 10
      prefix: --query=
      separate: false
  - id: target
    type: File
    doc: File containing the target sequence.
    inputBinding:
      position: 10
      prefix: --target=
      separate: false
  - id: suffix
    type:
      - 'null'
      - string
    doc: Specificy the suffix that was added by RNAup to the accessibility files.
    inputBinding:
      position: 10
      prefix: --suffix=
      separate: false
  - id: from_rnaplfold
    type:
      - 'null'
      - Directory
    doc: Specify the directory where accessibility profile generated by RNAplfold are found.
    inputBinding:
      position: 10
      prefix: --from-RNAplfold=
      separate: false
  - id: from_rnaup
    type:
      - 'null'
      - Directory
    doc: Specify the directory where accessibility profiles generated by RNAup are found.
    inputBinding:
      position: 10
      prefix: --from-RNAup=
      separate: false
  - id: output_directory
    type:
      - 'null'
      - string
    doc: Set where the generated figures should be stored.
    inputBinding:
      position: 10
      prefix: --output_directory=
      separate: false
  - id: alignment_mode
    type:
      - 'null'
      - boolean
    doc: Specify if RNAsnoop gets alignments or single sequences as input.
    inputBinding:
      position: 10
      prefix: --alignment-mode
  - id: fast_folding
    type:
      - 'null'
      - int
    doc: Speedup of the target search.
    inputBinding:
      position: 10
      prefix: --fast-folding=
      separate: false
  - id: extension_cost
    type:
      - 'null'
      - int
    doc: Cost to add to each nucleotide in a duplex.
    inputBinding:
      position: 10
      prefix: --extension-cost=
      separate: false
  - id: energy_threshold
    type:
      - 'null'
      - float
    doc: Maximal energy difference between the mfe and the desired suboptimal.
    inputBinding:
      position: 10
      prefix: --energy-threshold=
      separate: false
  - id: minimal_right_duplex
    type:
      - 'null'
      - int
    doc: Minimal Right Duplex Energy
    inputBinding:
      position: 10
      prefix: --minimal-right-duplex=
      separate: false
  - id: minimal_loop_energy
    type:
      - 'null'
      - int
    doc: Minimal Right Duplex Energy.
    inputBinding:
      position: 10
      prefix: --minimal-loop-energy=
      separate: false
  - id: minimal_left_duplex
    type:
      - 'null'
      - int
    doc: Minimal Left Duplex Energy.
    inputBinding:
      position: 10
      prefix: --minimal-left-duplex=
      separate: false
  - id: minimal_duplex
    type:
      - 'null'
      - int
    doc: Minimal Duplex Energy.
    inputBinding:
      position: 10
      prefix: --minimal-duplex=
      separate: false
  - id: duplex_distance
    type:
      - 'null'
      - int
    doc: Distance between target 3' ends of two consecutive duplexes.
    inputBinding:
      position: 10
      prefix: --duplex-distance=
      separate: false
  - id: minimal_stem_length
    type:
      - 'null'
      - int
    doc: Minimal snoRNA stem length.
    inputBinding:
      position: 10
      prefix: --minimal-stem-length=
      separate: false
  - id: maximal_stem_length
    type:
      - 'null'
      - int
    doc: Maximal snoRNA stem length.
    inputBinding:
      position: 10
      prefix: --maximal-stem-length=
      separate: false
  - id: minimal_duplex_box_length
    type:
      - 'null'
      - int
    doc: Minimal distance between the duplex end and the H/ACA box.
    inputBinding:
      position: 10
      prefix: --minimal-duplex-box-length=
      separate: false
  - id: maximal_duplex_box_length
    type:
      - 'null'
      - int
    doc: Maximal distance between the duplex end and the H/ACA box.
    inputBinding:
      position: 10
      prefix: --maximal-duplex-box-length=
      separate: false
  - id: minimal_snorna_stem_loop_length
    type:
      - 'null'
      - int
    doc: Minimal number of nucleotides between the beginning of stem loop and beginning of the snoRNA
      sequence.
    inputBinding:
      position: 10
      prefix: --minimal-snoRNA-stem-loop-length=
      separate: false
  - id: maximal_snorna_stem_loop_length
    type:
      - 'null'
      - int
    doc: Maximal number of nucleotides between the beginning of stem loop and beginning of the snoRNA
      sequence.
    inputBinding:
      position: 10
      prefix: --maximal-snoRNA-stem-loop-length=
      separate: false
  - id: minimal_snorna_duplex_length
    type:
      - 'null'
      - int
    doc: Minimal distance between duplex start and snoRNA.
    inputBinding:
      position: 10
      prefix: --minimal-snoRNA-duplex-length=
      separate: false
  - id: maximal_snorna_duplex_length
    type:
      - 'null'
      - int
    doc: Maximal distance between duplex start and snoRNA.
    inputBinding:
      position: 10
      prefix: --maximal-snoRNA-duplex-length=
      separate: false
  - id: minimal_duplex_stem_energy
    type:
      - 'null'
      - int
    doc: Minimal duplex stem energy.
    inputBinding:
      position: 10
      prefix: --minimal-duplex-stem-energy=
      separate: false
  - id: minimal_total_energy
    type:
      - 'null'
      - int
    doc: Minimal total energy.
    inputBinding:
      position: 10
      prefix: --minimal-total-energy=
      separate: false
  - id: maximal_stem_asymmetry
    type:
      - 'null'
      - int
    doc: Maximal snoRNA stem asymmetry.
    inputBinding:
      position: 10
      prefix: --maximal-stem-asymmetry=
      separate: false
  - id: minimal_lower_stem_energy
    type:
      - 'null'
      - int
    doc: Minimal lower stem energy.
    inputBinding:
      position: 10
      prefix: --minimal-lower-stem-energy=
      separate: false
  - id: alignment_length
    type:
      - 'null'
      - int
    doc: Limit the extent of the interactions to L nucleotides.
    inputBinding:
      position: 10
      prefix: --alignmentLength=
      separate: false
  - id: constraint
    type:
      - 'null'
      - boolean
    doc: Calculate the stem structure subject to constraints.
    inputBinding:
      position: 10
      prefix: --constraint
  - id: produce_ps
    type:
      - 'null'
      - boolean
    doc: Draw annotated 2D structures for a list of dot-bracket structures.
    inputBinding:
      position: 10
      prefix: --produce-ps
  - id: direct_redraw
    type:
      - 'null'
      - boolean
    doc: Outputs 2D interactions concurrently with the interaction calculation for each suboptimal interaction.
      The -I option should be preferred.
    inputBinding:
      position: 10
      prefix: --direct-redraw
outputs:
  - id: stdout
    type: stdout
    doc: Standard output of the program
  - id: ps_files
    type:
      type: array
      items: File
    doc: PostScript plots written by the program (structure plots, dot plots)
    outputBinding:
      glob:
        - '*.ps'
hints:
  - class: DockerRequirement
    dockerPull: quay.io/biocontainers/viennarna:2.7.2--py310pl5321haba5358_0
stdout: RNAsnoop.out
s:url: https://www.tbi.univie.ac.at/RNA/
$namespaces:
  s: https://schema.org/
