cwlVersion: v1.2
class: CommandLineTool
baseCommand: panaroo-spydrpick
label: panaroo_spydrpick
doc: "Identify associations between genes with the Spydrpick algorithm from a Panaroo gene presence/absence file.

Tool homepage: https://gtonkinhill.github.io/panaroo"
requirements:
  - class: InlineJavascriptRequirement
  - class: InitialWorkDirRequirement
    listing:
      - entry: '$({"class": "Directory", "basename": inputs.out_dir, "listing": []})'
        writable: true
inputs:
  - id: input
    type: File
    doc: "Gene presence absence file (.Rtab) generated by Panaroo."
    inputBinding:
      prefix: --input
  - id: out_dir
    type: string
    doc: "Location of an output directory."
    inputBinding:
      prefix: --out_dir
  - id: tree
    type:
      - 'null'
      - File
    doc: "Phylogeny in newick format for weighting samples to control for population structure."
    inputBinding:
      prefix: --tree
  - id: clusters
    type:
      - 'null'
      - File
    doc: "Sample clusters for weighting to control for population structure. Format: 'sample_name,cluster_id'."
    inputBinding:
      prefix: --clusters
  - id: quantile
    type:
      - 'null'
      - float
    doc: "The quantile used to determine a threshold for keeping MI values (default 0.9)."
    inputBinding:
      prefix: --quantile
  - id: aracne
    type:
      - 'null'
      - boolean
    doc: "Turn on the Aracne stage of the algorithm."
    inputBinding:
      prefix: --aracne
outputs:
  - id: output_dir
    type:
      - 'null'
      - Directory
    doc: "Output directory with the gene association results."
    outputBinding:
      glob: $(inputs.out_dir)
  - id: stdout
    type: stdout
    doc: Standard output
hints:
  - class: DockerRequirement
    dockerPull: quay.io/biocontainers/panaroo:1.6.0--pyhdfd78af_0
stdout: panaroo_spydrpick.out
