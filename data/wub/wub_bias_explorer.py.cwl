cwlVersion: v1.2
class: CommandLineTool
baseCommand:
  - bias_explorer.py
label: wub_bias_explorer.py
doc: 'Simple tool for exploring biases in transcript counts. Takes as input count
  files generated by bam_count_reads.py (with the -z flag) and performs linear regression
  of log counts against transcript length and GC content.


  Tool homepage: https://github.com/nanoporetech/wub'
inputs:
  - id: count_file
    type: File
    doc: Input counts file with length ang GC content features.
    inputBinding:
      position: 1
  - id: report_pdf
    type:
      - 'null'
      - string
    doc: Report PDF (bias_explorer.pdf).
    default: bias_explorer.pdf
    inputBinding:
      position: 102
      prefix: -r
  - id: exclude_zero
    type:
      - 'null'
      - boolean
    doc: Exclude transcripts with zero counts.
    inputBinding:
      position: 102
      prefix: -x
outputs:
  - id: report
    type: File
    doc: Bias exploration report (PDF).
    outputBinding:
      glob: $(inputs.report_pdf)
requirements:
  - class: EnvVarRequirement
    envDef:
      MPLBACKEND: Agg
hints:
  - class: DockerRequirement
    dockerPull: quay.io/biocontainers/wub:0.5.1--pyh3252c3a_0
