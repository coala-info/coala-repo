cwlVersion: v1.2
class: CommandLineTool
baseCommand: vcfSampleCompare.pl
label: vcfsamplecompare_vcfSampleCompare.pl
doc: "Sort and filter the variant records of a VCF file (freeBayes or svTyper output
  with 2 or more samples) by the difference in variant data between groups of samples.
  The variants with the biggest difference come first; variants with little or no
  difference come last or are filtered out.\n\nTool homepage: https://github.com/hepcat72/vcfSampleCompare"
inputs:
  - id: input_vcf
    type: File[]
    doc: VCF input file(s) generated by freeBayes or svTyper
    inputBinding:
      position: 101
      prefix: -i
  - id: vcf_outfile_suffix
    type: string
    doc: VCF outfile suffix (appended to the input file name)
    inputBinding:
      position: 1
      prefix: -o
  - id: summary_outfile_suffix
    type: string
    doc: Summary outfile suffix (appended to the input file name). The help
      default is standard output; this wrapper always writes the summary file.
    inputBinding:
      position: 1
      prefix: -u
  - id: sample_groups
    type:
      - 'null'
      - type: array
        items: string
        inputBinding:
          prefix: -s
    doc: Groups of sample names for difference comparisons. Give each group as
      one string with names separated by spaces. Groups are used in pairs.
    inputBinding:
      position: 1
  - id: min_group_size
    type:
      - 'null'
      - type: array
        items: int
        inputBinding:
          prefix: -d
    doc: Minimum number of samples to use in a group to determine difference with
      its partner. One value per sample group, in the same order.
    inputBinding:
      position: 1
  - id: min_or_score
    type:
      - 'null'
      - float
    doc: Minimum observation ratio difference [0-1] (help default 0.7).
    inputBinding:
      position: 1
      prefix: -a
  - id: gap_measure
    type:
      - 'null'
      - string
    doc: Method to measure the gap between observation ratios, mean or edge (help
      default mean).
    inputBinding:
      position: 1
      prefix: -m
  - id: no_genotype
    type:
      - 'null'
      - boolean
    doc: Do not use genotype calls for sorting and filtering.
    inputBinding:
      position: 1
      prefix: --no-g
  - id: no_filter
    type:
      - 'null'
      - boolean
    doc: Do not filter variant rows.
    inputBinding:
      position: 1
      prefix: --no-f
  - id: no_grow
    type:
      - 'null'
      - boolean
    doc: Do not add samples to sample groups beyond the minimum group size.
    inputBinding:
      position: 1
      prefix: --no-w
  - id: min_depth
    type:
      - 'null'
      - int
    doc: Minimum read depth (DP) (help default 4).
    inputBinding:
      position: 1
      prefix: -l
  - id: adequate_depth
    type:
      - 'null'
      - int
    doc: Adequate read depth (DP) (help default 20).
    inputBinding:
      position: 1
      prefix: -x
  - id: no_header
    type:
      - 'null'
      - boolean
    doc: Do not write the commented header with version, date and command line in
      output files.
    inputBinding:
      position: 1
      prefix: --noheader
outputs:
  - id: vcf_files
    type: File[]
    doc: Sorted (and possibly filtered) VCF files, one per input file
    outputBinding:
      glob: $('*' + inputs.vcf_outfile_suffix)
  - id: summary_files
    type: File[]
    doc: Summary files with the sorting values and the sample groups found
    outputBinding:
      glob: $('*' + inputs.summary_outfile_suffix)
  - id: stdout
    type: stdout
    doc: Standard output
requirements:
  - class: InitialWorkDirRequirement
    listing:
      - $(inputs.input_vcf)
  - class: InlineJavascriptRequirement
hints:
  - class: DockerRequirement
    dockerPull: quay.io/biocontainers/vcfsamplecompare:2.013--pl526_0
stdout: vcfsamplecompare_vcfSampleCompare.pl.out
