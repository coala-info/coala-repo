cwlVersion: v1.2
class: CommandLineTool
baseCommand: NanoSV
label: nanosv
doc: "NanoSV is a software tool for the detection of structural variations (SVs) in long-read sequencing data, such as those generated by Oxford Nanopore Technologies (ONT).\n\nTool homepage: https://github.com/mroosmalen/nanosv"
inputs:
  - id: bam
    type: File
    secondaryFiles:
      - .bai
    doc: Input BAM file (sorted, indexed).
    inputBinding:
      position: 101
  - id: threads
    type:
      - 'null'
      - int
    doc: Number of threads [default 4].
    inputBinding:
      position: 1
      prefix: --threads
  - id: sambamba
    type:
      - 'null'
      - string
    doc: Name or full path of the sambamba or samtools executable [default sambamba].
    inputBinding:
      position: 1
      prefix: --sambamba
  - id: config
    type:
      - 'null'
      - File
    doc: Your own ini file [default config.ini].
    inputBinding:
      position: 1
      prefix: --config
  - id: bed
    type:
      - 'null'
      - File
    doc: Your own bed file, used for coverage depth calculations [default human_hg19.bed].
    inputBinding:
      position: 1
      prefix: --bed
  - id: output
    type:
      - 'null'
      - string
    doc: Output vcf file [default stdout].
    inputBinding:
      position: 1
      prefix: --output
  - id: snp_file
    type:
      - 'null'
      - File
    doc: SNP variant file for phasing. Supported file formats are BED and VCF.
    inputBinding:
      position: 1
      prefix: --snp_file
outputs:
  - id: output_vcf
    type:
      - 'null'
      - File
    doc: Output VCF file, written when --output is given.
    outputBinding:
      glob: $(inputs.output)
  - id: stdout_vcf
    type: stdout
    doc: VCF written to standard output when --output is not given.
stdout: nanosv.stdout.vcf
requirements:
  - class: InlineJavascriptRequirement
  - class: EnvVarRequirement
    envDef:
      - envName: LC_ALL
        envValue: C.UTF-8
      - envName: LANG
        envValue: C.UTF-8
hints:
  - class: DockerRequirement
    dockerPull: quay.io/biocontainers/nanosv:1.2.4--py_0
