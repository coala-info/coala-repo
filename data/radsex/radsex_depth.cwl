cwlVersion: v1.2
class: CommandLineTool
baseCommand:
  - radsex
  - depth
label: radsex_depth
doc: "Computes the number of retained reads for each individual.\n\nTool homepage:\
  \ https://github.com/SexGenomicsToolkit/radsex"
inputs:
  - id: markers_table
    type: File
    doc: Path to a marker depths table generated by "process"
    inputBinding:
      position: 101
      prefix: --markers-table
  - id: popmap
    type: File
    doc: Path to a tabulated file specifying groups for all individuals (population
      map)
    inputBinding:
      position: 101
      prefix: --popmap
  - id: min_frequency
    type:
      - 'null'
      - float
    doc: Minimum frequency of a marker in all individuals to retain this marker in
      depth computations
    inputBinding:
      position: 101
      prefix: --min-frequency
  - id: output_file_path
    type: string
    doc: Path to the output file (table of depth for each individual)
    inputBinding:
      position: 102
      prefix: --output-file
outputs:
  - id: output_file
    type: File
    doc: Path to the output file (table of depth for each individual)
    outputBinding:
      glob: $(inputs.output_file_path)
hints:
  - class: DockerRequirement
    dockerPull: quay.io/biocontainers/radsex:1.2.0--h43eeafb_3
