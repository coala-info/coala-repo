cwlVersion: v1.2
class: CommandLineTool
baseCommand: NanoStat
label: nanostat
doc: "Calculate statistics of long read sequencing dataset.\n\nTool homepage: https://github.com/wdecoster/nanostat"
inputs:
  - id: fastq
    type:
      - 'null'
      - type: array
        items: File
        inputBinding:
          prefix: --fastq
    doc: Data is in one or more (compressed) fastq file(s).
  - id: fasta
    type:
      - 'null'
      - type: array
        items: File
        inputBinding:
          prefix: --fasta
    doc: Data is in one or more (compressed) fasta file(s).
  - id: summary
    type:
      - 'null'
      - type: array
        items: File
        inputBinding:
          prefix: --summary
    doc: Data is in one or more (compressed) summary file(s) generated by albacore or guppy.
  - id: bam
    type:
      - 'null'
      - type: array
        items: File
        inputBinding:
          prefix: --bam
    doc: Data is in one or more sorted bam file(s).
  - id: ubam
    type:
      - 'null'
      - type: array
        items: File
        inputBinding:
          prefix: --ubam
    doc: Data is in one or more unmapped bam file(s).
  - id: cram
    type:
      - 'null'
      - type: array
        items: File
        inputBinding:
          prefix: --cram
    doc: Data is in one or more sorted cram file(s).
  - id: feather
    type:
      - 'null'
      - type: array
        items: File
        inputBinding:
          prefix: --feather
    doc: Data is in one or more feather file(s).
  - id: outdir_path
    type:
      - 'null'
      - string
    doc: Specify directory for output, only in combination with --name.
    inputBinding:
      position: 101
      prefix: --outdir
  - id: prefix
    type:
      - 'null'
      - string
    doc: Specify an optional prefix to be used for the output file.
    inputBinding:
      position: 101
      prefix: --prefix
  - id: dataset_name
    type:
      - 'null'
      - string
    doc: Specify a filename/path for the output, stdout is the default.
    inputBinding:
      position: 101
      prefix: --name
  - id: threads
    type:
      - 'null'
      - int
    doc: Set the allowed number of threads to be used by the script.
    inputBinding:
      position: 101
      prefix: --threads
  - id: tsv
    type:
      - 'null'
      - boolean
    doc: Output the stats as a properly formatted TSV.
    inputBinding:
      position: 101
      prefix: --tsv
  - id: barcoded
    type:
      - 'null'
      - boolean
    doc: Use if you want to split the summary file by barcode.
    inputBinding:
      position: 101
      prefix: --barcoded
  - id: readtype
    type:
      - 'null'
      - string
    doc: Which read type to extract information about from summary (1D, 2D, 1D2).
    inputBinding:
      position: 101
      prefix: --readtype
  - id: no_supplementary
    type:
      - 'null'
      - boolean
    doc: Use if you want to remove supplementary alignments.
    inputBinding:
      position: 101
      prefix: --no_supplementary
outputs:
  - id: stats_stdout
    type: stdout
  - id: stats_file
    type:
      - 'null'
      - File
    doc: Statistics file written when --name is given.
    outputBinding:
      glob: "$(inputs.dataset_name ? (inputs.outdir_path ? inputs.outdir_path + '/' : '') + (inputs.prefix ? inputs.prefix : '') + inputs.dataset_name : 'nanostat_stats.txt')"
stdout: nanostat_stats.txt
requirements:
  - class: InlineJavascriptRequirement
  - class: InitialWorkDirRequirement
    listing: |
      ${
        var l = [];
        var a = (inputs.bam || []).concat(inputs.cram || []);
        for (var i = 0; i < a.length; i++) { l.push({entry: a[i], writable: true}); }
        return l;
      }
hints:
  - class: DockerRequirement
    dockerPull: quay.io/biocontainers/nanostat:1.6.0--pyhdfd78af_0
