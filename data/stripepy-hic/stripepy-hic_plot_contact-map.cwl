cwlVersion: v1.2
class: CommandLineTool
baseCommand:
  - stripepy
  - plot
  - contact-map
label: stripepy-hic_plot_contact-map
doc: "Plot stripes and other features over the Hi-C matrix.\n\nTool homepage: https://github.com/paulsengroup/StripePy"
inputs:
  - id: contact_map
    type: File
    doc: Path to the .cool, .mcool, or .hic file used to call stripes.
    inputBinding:
      position: 101
  - id: resolution
    type: int
    doc: Resolution (in bp).
    inputBinding:
      position: 102
  - id: output_name
    type: string
    doc: Path where to store the generated plot.
    inputBinding:
      position: 103
  - id: stripepy_hdf5
    type:
      - 'null'
      - File
    doc: Path to the .hdf5 generated by stripepy call; required when highlighting stripes or seeds.
    inputBinding:
      position: 1
      prefix: --stripepy-hdf5
  - id: relative_change_threshold
    type:
      - 'null'
      - float
    doc: Cutoff for the relative change; only used when highlighting architectural stripes
    inputBinding:
      position: 1
      prefix: --relative-change-threshold
  - id: coefficient_of_variation_threshold
    type:
      - 'null'
      - float
    doc: Cutoff for the coefficient of variation; only used when highlighting architectural stripes
    inputBinding:
      position: 1
      prefix: --coefficient-of-variation-threshold
  - id: highlight_seeds
    type:
      - 'null'
      - boolean
    doc: Highlight the stripe seeds
    inputBinding:
      position: 1
      prefix: --highlight-seeds
  - id: highlight_stripes
    type:
      - 'null'
      - boolean
    doc: Highlight the architectural stripes
    inputBinding:
      position: 1
      prefix: --highlight-stripes
  - id: ignore_stripe_heights
    type:
      - 'null'
      - boolean
    doc: Ignore the stripes height; no effect when --highlight-stripes is not specified
    inputBinding:
      position: 1
      prefix: --ignore-stripe-heights
  - id: cmap
    type:
      - 'null'
      - string
    doc: Color map used to plot Hi-C interactions (default fruit_punch)
    inputBinding:
      position: 1
      prefix: --cmap
  - id: linear_scale
    type:
      - 'null'
      - boolean
    doc: Plot interactions in linear scale
    inputBinding:
      position: 1
      prefix: --linear-scale
  - id: log_scale
    type:
      - 'null'
      - boolean
    doc: Plot interactions in log scale (default)
    inputBinding:
      position: 1
      prefix: --log-scale
  - id: region
    type:
      - 'null'
      - string
    doc: Genomic region to be plotted (UCSC format); when not specified, a random 2.5Mb region is plotted
    inputBinding:
      position: 1
      prefix: --region
  - id: dpi
    type:
      - 'null'
      - int
    doc: DPI of the generated plot (default 300)
    inputBinding:
      position: 1
      prefix: --dpi
  - id: seed
    type:
      - 'null'
      - long
    doc: Seed for random number generation
    inputBinding:
      position: 1
      prefix: --seed
  - id: normalization
    type:
      - 'null'
      - string
    doc: Normalization to fetch
    inputBinding:
      position: 1
      prefix: --normalization
  - id: force
    type:
      - 'null'
      - boolean
    doc: Overwrite existing file(s)
    inputBinding:
      position: 1
      prefix: --force
  - id: verbosity
    type:
      - 'null'
      - string
    doc: Set verbosity of output to the console (debug, info, warning, error, critical; default info)
    inputBinding:
      position: 1
      prefix: --verbosity
outputs:
  - id: plot
    type: File
    doc: Generated plot
    outputBinding:
      glob: $(inputs.output_name)
requirements:
  - class: InlineJavascriptRequirement
hints:
  - class: DockerRequirement
    dockerPull: quay.io/biocontainers/stripepy-hic:1.3.0--pyh2a3209d_1
