cwlVersion: v1.2
class: CommandLineTool
baseCommand: [rsem-bam2wig]
label: rsem_rsem-bam2wig
doc: "Generate a wiggle (read coverage) file from a sorted SAM/BAM/CRAM alignment file.\n\nTool homepage: https://deweylab.github.io/RSEM/"
inputs:
  - id: sorted_alignment_file
    type: File
    doc: Sorted alignment file in SAM/BAM/CRAM format.
    inputBinding:
      position: 1
  - id: wig_output
    type: string
    doc: Output wiggle file name, e.g. output.wig.
    inputBinding:
      position: 2
  - id: wiggle_name
    type: string
    doc: The name of this wiggle plot.
    inputBinding:
      position: 3
  - id: no_fractional_weight
    type: ['null', boolean]
    doc: Do not look for the "ZW" tag; every alignment in the file has weight 1. Set this if the BAM file was not generated by RSEM.
    inputBinding:
      position: 4
      prefix: --no-fractional-weight
outputs:
  - id: wiggle
    type: File
    doc: Output wiggle file.
    outputBinding:
      glob: $(inputs.wig_output)
hints:
  - class: DockerRequirement
    dockerPull: quay.io/biocontainers/rsem:1.3.3--pl5321h077b44d_12
