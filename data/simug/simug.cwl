cwlVersion: v1.2
class: CommandLineTool
baseCommand: simuG
label: simug
doc: "simuG simulates genome sequences with SNPs, INDELs, CNVs, inversions and
  translocations introduced into a reference genome. It writes the simulated genome
  and VCF files describing the introduced variants.\n\nTool homepage: https://github.com/yjx1217/simuG"
inputs:
  - id: refseq
    type: File
    doc: "Reference genome to be used as the template (fasta or fasta.gz). Mandatory."
    inputBinding:
      position: 1
      prefix: -refseq
  - id: snp_vcf
    type:
      - 'null'
      - File
    doc: "List of exact SNP variants to be introduced (vcf or vcf.gz). Overrides snp_count, snp_model and titv_ratio."
    inputBinding:
      position: 1
      prefix: -snp_vcf
  - id: snp_count
    type:
      - 'null'
      - int
    doc: "Number of SNP variants to be introduced."
    inputBinding:
      position: 1
      prefix: -snp_count
  - id: snp_model
    type:
      - 'null'
      - File
    doc: "SNP model file generated by vcf2model. Overrides titv_ratio."
    inputBinding:
      position: 1
      prefix: -snp_model
  - id: titv_ratio
    type:
      - 'null'
      - string
    doc: "Ti/Tv ratio used to simulate SNP variants (default 0.5; Inf for transitions only, 0 for transversions only)."
    inputBinding:
      position: 1
      prefix: -titv_ratio
  - id: coding_partition_for_snp_simulation
    type:
      - 'null'
      - string
    doc: "Coding partition (noncoding, coding, 2d or 4d) used to constrain simulated SNPs. Used together with gene_gff."
    inputBinding:
      position: 1
      prefix: -coding_partition_for_snp_simulation
  - id: indel_vcf
    type:
      - 'null'
      - File
    doc: "List of exact INDEL variants to be introduced (vcf or vcf.gz)."
    inputBinding:
      position: 1
      prefix: -indel_vcf
  - id: indel_count
    type:
      - 'null'
      - int
    doc: "Number of INDEL variants to be introduced."
    inputBinding:
      position: 1
      prefix: -indel_count
  - id: indel_model
    type:
      - 'null'
      - File
    doc: "INDEL model file generated by vcf2model."
    inputBinding:
      position: 1
      prefix: -indel_model
  - id: ins_del_ratio
    type:
      - 'null'
      - string
    doc: "Insertion/Deletion ratio used to simulate INDEL variants (default 1.0; Inf for insertions only, 0 for deletions only)."
    inputBinding:
      position: 1
      prefix: -ins_del_ratio
  - id: indel_size_powerlaw_alpha
    type:
      - 'null'
      - float
    doc: "Exponent alpha for the power-law-fitted indel size distribution p = C * size ** -alpha, size 1 to 50 (default 2.0)."
    inputBinding:
      position: 1
      prefix: -indel_size_powerlaw_alpha
  - id: indel_size_powerlaw_constant
    type:
      - 'null'
      - float
    doc: "Constant C for the power-law-fitted indel size distribution (default 0.5)."
    inputBinding:
      position: 1
      prefix: -indel_size_powerlaw_constant
  - id: cnv_vcf
    type:
      - 'null'
      - File
    doc: "List of exact CNV variants to be introduced (vcf or vcf.gz)."
    inputBinding:
      position: 1
      prefix: -cnv_vcf
  - id: cnv_count
    type:
      - 'null'
      - int
    doc: "Number of CNV variants to be introduced."
    inputBinding:
      position: 1
      prefix: -cnv_count
  - id: cnv_gain_loss_ratio
    type:
      - 'null'
      - string
    doc: "Relative ratio of DNA gain over DNA loss (default 1.0; Inf for gains only, 0 for losses only)."
    inputBinding:
      position: 1
      prefix: -cnv_gain_loss_ratio
  - id: cnv_max_copy_number
    type:
      - 'null'
      - int
    doc: "Maximal copy number for CNV (default 10)."
    inputBinding:
      position: 1
      prefix: -cnv_max_copy_number
  - id: cnv_min_size
    type:
      - 'null'
      - int
    doc: "Minimal size in basepair for CNV variants (default 100)."
    inputBinding:
      position: 1
      prefix: -cnv_min_size
  - id: cnv_max_size
    type:
      - 'null'
      - int
    doc: "Maximal size in basepair for CNV variants (default 100000)."
    inputBinding:
      position: 1
      prefix: -cnv_max_size
  - id: duplication_tandem_dispersed_ratio
    type:
      - 'null'
      - string
    doc: "Expected frequency ratio between tandem and dispersed duplications for CNV variants (default 1; Inf for tandem only, 0 for dispersed only)."
    inputBinding:
      position: 1
      prefix: -duplication_tandem_dispersed_ratio
  - id: inversion_vcf
    type:
      - 'null'
      - File
    doc: "List of exact inversions to be introduced (vcf or vcf.gz)."
    inputBinding:
      position: 1
      prefix: -inversion_vcf
  - id: inversion_count
    type:
      - 'null'
      - int
    doc: "Number of inversions to be introduced."
    inputBinding:
      position: 1
      prefix: -inversion_count
  - id: inversion_min_size
    type:
      - 'null'
      - int
    doc: "Minimal size in basepair for inversions (default 1000)."
    inputBinding:
      position: 1
      prefix: -inversion_min_size
  - id: inversion_max_size
    type:
      - 'null'
      - int
    doc: "Maximal size in basepair for inversions (default 100000)."
    inputBinding:
      position: 1
      prefix: -inversion_max_size
  - id: inversion_breakpoint_gff
    type:
      - 'null'
      - File
    doc: "List of potential breakpoints for triggering inversions (gff3 or gff3.gz)."
    inputBinding:
      position: 1
      prefix: -inversion_breakpoint_gff
  - id: translocation_vcf
    type:
      - 'null'
      - File
    doc: "List of exact translocations to be introduced (vcf or vcf.gz)."
    inputBinding:
      position: 1
      prefix: -translocation_vcf
  - id: translocation_count
    type:
      - 'null'
      - int
    doc: "Number of translocations to be introduced."
    inputBinding:
      position: 1
      prefix: -translocation_count
  - id: translocation_breakpoint_gff
    type:
      - 'null'
      - File
    doc: "List of potential breakpoints for triggering translocations (gff3 or gff3.gz)."
    inputBinding:
      position: 1
      prefix: -translocation_breakpoint_gff
  - id: centromere_gff
    type:
      - 'null'
      - File
    doc: "Centromeres for constraining the random CNV, inversion and translocation simulation (gff3 or gff3.gz)."
    inputBinding:
      position: 1
      prefix: -centromere_gff
  - id: gene_gff
    type:
      - 'null'
      - File
    doc: "Genes for constraining the random SNP, CNV, inversion and translocation simulation (gff3 or gff3.gz)."
    inputBinding:
      position: 1
      prefix: -gene_gff
  - id: excluded_chr_list
    type:
      - 'null'
      - File
    doc: "Single-column list file with the names of chromosomes to be excluded for introducing variants."
    inputBinding:
      position: 1
      prefix: -excluded_chr_list
  - id: seed
    type:
      - 'null'
      - long
    doc: "Integer as the random seed for the simulation."
    inputBinding:
      position: 1
      prefix: -seed
  - id: prefix
    type:
      - 'null'
      - string
    doc: "Prefix for output files (default: output_prefix)."
    inputBinding:
      position: 1
      prefix: -prefix
outputs:
  - id: output_files
    type:
      type: array
      items: File
    doc: Simulated genome (fasta), variant files (vcf) and the reference to simulated sequence coordinate map, all named with the prefix
    outputBinding:
      glob: '$(inputs.prefix ? inputs.prefix : "output_prefix")*'
requirements:
  - class: InlineJavascriptRequirement
hints:
  - class: DockerRequirement
    dockerPull: quay.io/biocontainers/simug:1.0.1--hdfd78af_0
