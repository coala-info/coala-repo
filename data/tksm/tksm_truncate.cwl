cwlVersion: v1.2
class: CommandLineTool
baseCommand:
  - tksm
  - truncate
label: tksm_truncate
doc: "Truncate module: simulates read truncation of molecules (MDF)\n\nTool homepage: https://github.com/vpc-ccg/tksm"
inputs:
  - id: input
    type: File
    doc: "input mdf file"
    inputBinding:
      position: 1
      prefix: --input
  - id: output
    type: string
    doc: "output mdf file"
    inputBinding:
      position: 1
      prefix: --output
  - id: kde_model
    type:
      - 'null'
      - File
    doc: "[model].json generated by the truncation modelling"
    inputBinding:
      position: 1
      prefix: --kde-model
  - id: always_end
    type:
      - 'null'
      - boolean
    doc: "Ignore sider.tsv and always 3' end truncate"
    inputBinding:
      position: 1
      prefix: --always-end
  - id: kde_models_length
    type:
      - 'null'
      - boolean
    doc: "KDE models read length instead of truncation length"
    inputBinding:
      position: 1
      prefix: --kde-models-length
  - id: normal
    type:
      - 'null'
      - string
    doc: "Use Normal distribution [mu,sigma]"
    inputBinding:
      position: 1
      prefix: --normal
  - id: lognormal
    type:
      - 'null'
      - string
    doc: "Use Log-Normal distribution [mu,sigma]"
    inputBinding:
      position: 1
      prefix: --lognormal
  - id: seed
    type:
      - 'null'
      - int
    doc: "Random seed (default: 42)"
    inputBinding:
      position: 1
      prefix: --seed
  - id: verbosity
    type:
      - 'null'
      - string
    doc: "Verbosity level to choose from [DEBUG, ERROR, INFO, OFF, WARN] (default: INFO)"
    inputBinding:
      position: 1
      prefix: --verbosity
  - id: log_file
    type:
      - 'null'
      - string
    doc: "Log file to write the logs (or stderr/stdout) (default: stderr)"
    inputBinding:
      position: 1
      prefix: --log-file
outputs:
  - id: truncated
    type: File
    doc: "Truncated molecules (MDF)"
    outputBinding:
      glob: "$(inputs.output)"
  - id: stdout
    type: stdout
    doc: Standard output
requirements:
  - class: InlineJavascriptRequirement
hints:
  - class: DockerRequirement
    dockerPull: quay.io/biocontainers/tksm:0.6.1--py310ha025fb0_1
stdout: tksm_truncate.out
