cwlVersion: v1.2
class: CommandLineTool
baseCommand: NanoStat
label: nanopack_NanoStat
doc: "NanoStat: Calculate statistics of long read sequencing data and generate plots.\n\
  \ \nTool homepage: https://github.com/wdecoster/nanopack"
inputs:
  - id: bam
    type:
      - 'null'
      - type: array
        items: File
    secondaryFiles:
      - pattern: .bai
        required: false
    doc: Input sorted bam file(s)
    inputBinding:
      position: 101
      prefix: --bam
  - id: ubam
    type:
      - 'null'
      - type: array
        items: File
    doc: Data is in one or more unmapped bam file(s).
    inputBinding:
      position: 101
      prefix: --ubam
  - id: cram
    type:
      - 'null'
      - type: array
        items: File
    secondaryFiles:
      - pattern: .crai
        required: false
    doc: Data is in one or more sorted cram file(s).
    inputBinding:
      position: 101
      prefix: --cram
  - id: feather
    type:
      - 'null'
      - type: array
        items: File
    doc: Data is in one or more feather file(s).
    inputBinding:
      position: 101
      prefix: --feather
  - id: no_supplementary
    type:
      - 'null'
      - boolean
    doc: Use if you want to remove supplementary alignments
    inputBinding:
      position: 101
      prefix: --no_supplementary
  - id: name
    type:
      - 'null'
      - string
    doc: Specify a filename/path for the output, stdout is the default.
    inputBinding:
      position: 101
      prefix: --name
  - id: barcoded
    type:
      - 'null'
      - boolean
    doc: Use if you want to split the summary file by barcode
    inputBinding:
      position: 101
      prefix: --barcoded
  - id: fasta
    type:
      - 'null'
      - type: array
        items: File
    doc: Input fasta file(s)
    inputBinding:
      position: 101
      prefix: --fasta
  - id: fastq
    type:
      - 'null'
      - type: array
        items: File
    doc: Input fastq file(s)
    inputBinding:
      position: 101
      prefix: --fastq
  - id: prefix
    type:
      - 'null'
      - string
    doc: Prefix for the output files
    inputBinding:
      position: 101
      prefix: --prefix
  - id: readtype
    type:
      - 'null'
      - string
    doc: 'Which read type to extract information about from summary. Options: 1D,
      2D, 1D2'
    inputBinding:
      position: 101
      prefix: --readtype
  - id: summary
    type:
      - 'null'
      - type: array
        items: File
    doc: Input sequencing_summary file(s) generated by albacore or guppy
    inputBinding:
      position: 101
      prefix: --summary
  - id: threads
    type:
      - 'null'
      - int
    doc: Number of threads to use
    inputBinding:
      position: 101
      prefix: --threads
  - id: tsv
    type:
      - 'null'
      - boolean
    doc: Output statistics in a tab-separated values file
    inputBinding:
      position: 101
      prefix: --tsv
  - id: outdir_path
    type:
      - 'null'
      - string
    doc: Specify directory for output, only in combination with --name.
    inputBinding:
      position: 102
      prefix: --outdir
outputs:
  - id: outdir
    type:
      - 'null'
      - Directory
    doc: Directory to write output files to
    outputBinding:
      glob: $(inputs.outdir_path)
  - id: stdout
    type: stdout
    doc: Statistics report (default output when --name is not given)
requirements:
  - class: InlineJavascriptRequirement
hints:
  - class: DockerRequirement
    dockerPull: quay.io/biocontainers/nanopack:1.1.1--hdfd78af_0
stdout: nanostat.out
