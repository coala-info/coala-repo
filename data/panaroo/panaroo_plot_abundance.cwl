cwlVersion: v1.2
class: CommandLineTool
baseCommand: panaroo-plot-abundance
label: panaroo_plot_abundance
doc: "Generate gene abundance and pangenome size estimation plots from a Panaroo gene presence/absence file.

Tool homepage: https://gtonkinhill.github.io/panaroo"
requirements:
  - class: InlineJavascriptRequirement
  - class: InitialWorkDirRequirement
    listing:
      - entry: '$({"class": "Directory", "basename": inputs.out_dir, "listing": []})'
        writable: true
inputs:
  - id: input
    type: File
    doc: "Gene presence absence file generated by Panaroo (gene_presence_absence_roary.csv)."
    inputBinding:
      prefix: --input
  - id: out_dir
    type: string
    doc: "Location of an output directory."
    inputBinding:
      prefix: --out_dir
  - id: graph_type
    type:
      - 'null'
      - string
    doc: "The type of graph to generate: jack2, acc, ICE, jack1, chao2 or all."
    inputBinding:
      prefix: --graph_type
  - id: nboot
    type:
      - 'null'
      - int
    doc: "The number of bootstrap replicates (default 100)."
    inputBinding:
      prefix: --nboot
outputs:
  - id: output_dir
    type:
      - 'null'
      - Directory
    doc: "Output directory with the plots."
    outputBinding:
      glob: $(inputs.out_dir)
  - id: stdout
    type: stdout
    doc: Standard output
hints:
  - class: DockerRequirement
    dockerPull: quay.io/biocontainers/panaroo:1.6.0--pyhdfd78af_0
stdout: panaroo_plot_abundance.out
