cwlVersion: v1.2
class: CommandLineTool
baseCommand: [NCBImetaExport]
label: ncbimeta_NCBImetaExport
doc: "NCBImeta export tool: export an SQLite database to tabular text files.\n\nTool homepage: https://github.com/ktmeaton/NCBImeta"
inputs:
  - id: database
    type: File
    doc: "Path to the sqlite database generated by NCBImeta."
    inputBinding:
      position: 1
      prefix: --database
  - id: outputdir
    type: string
    doc: "Output directory (created by the tool)."
    inputBinding:
      position: 1
      prefix: --outputdir
outputs:
  - id: exported
    type: Directory
    doc: Directory with one tab-delimited file per table.
    outputBinding:
      glob: $(inputs.outputdir)
  - id: stdout
    type: stdout
    doc: Standard output
stdout: NCBImetaExport.stdout.txt
requirements:
  - class: InlineJavascriptRequirement
hints:
  - class: DockerRequirement
    dockerPull: quay.io/biocontainers/ncbimeta:0.8.3--pyhdfd78af_0
