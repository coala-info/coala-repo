cwlVersion: v1.2
class: CommandLineTool
baseCommand:
  - SemiBin2
  - single_easy_bin
label: semibin_single_easy_bin
doc: 'Bin contigs (single or co-assembly) using one command.


  Tool homepage: https://github.com/BigDataBiology/SemiBin'
inputs:
  - id: write_pre_reclustering_bins
    type:
      - 'null'
      - boolean
    doc: Write pre-reclustering bins to disk.
    inputBinding:
      position: 1
      prefix: --write-pre-reclustering-bins
  - id: no_write_pre_reclustering_bins
    type:
      - 'null'
      - boolean
    doc: Write pre-reclustering bins to disk.
    inputBinding:
      position: 1
      prefix: --no-write-pre-reclustering-bins
  - id: tag_output
    type:
      - 'null'
      - string
    doc: Tag to add to output file names
    inputBinding:
      position: 1
      prefix: --tag-output
  - id: compression
    type:
      - 'null'
      - string
    doc: 'Compression type for the output files (accepted values: gz [default]/xz/bz2/none).'
    inputBinding:
      position: 1
      prefix: --compression
  - id: orf_finder
    type:
      - 'null'
      - string
    doc: ORF finder used to estimate the number of bins (fast- naive/prodigal/fraggenescan)
    inputBinding:
      position: 1
      prefix: --orf-finder
  - id: prodigal_output_faa
    type:
      - 'null'
      - File
    doc: '[deprecated] Bypasses ORF calling and uses the provided .faa file instead
      (must be in same format as prodigal output).'
    inputBinding:
      position: 1
      prefix: --prodigal-output-faa
  - id: depth_metabat2
    type:
      - 'null'
      - File
    doc: depth file generated by metabat2 (only used with single-sample binning)
    inputBinding:
      position: 1
      prefix: --depth-metabat2
  - id: tmpdir
    type:
      - 'null'
      - string
    doc: option to set temporary directory
    inputBinding:
      position: 1
      prefix: --tmpdir
  - id: processes
    type:
      - 'null'
      - int
    doc: 'Number of CPUs used (pass the value 0 to use all CPUs, default: 0)'
    inputBinding:
      position: 1
      prefix: --processes
  - id: environment
    type:
      - 'null'
      - string
    doc: 'Environment for the built-in model (available choices: human_gut/dog_gut/ocean/soil/cat_gut/human_oral/mouse_
      gut/pig_gut/built_environment/wastewater/chicken_caecu m/global).'
    inputBinding:
      position: 1
      prefix: --environment
  - id: min_len
    type:
      - 'null'
      - int
    doc: 'Minimal length for contigs in binning. If you use SemiBin with multi steps
      and you use this parameter, please use this parameter consistently with all
      subcommands. (Default: SemiBin chooses 1000bp or 2500bp according the ratio
      of the number of base pairs of contigs between 1000-2500bp).'
    inputBinding:
      position: 1
      prefix: --min-len
  - id: ratio
    type:
      - 'null'
      - float
    doc: 'If the ratio of the number of base pairs of contigs between 1000-2500 bp
      smaller than this value, the minimal length will be set as 1000bp, otherwise
      2500bp. Note that setting `--min-length/-m` overrules this parameter. If you
      use SemiBin with multi steps and you use this parameter, please use this parameter
      consistently with all subcommands. (Default: 0.05)'
    inputBinding:
      position: 1
      prefix: --ratio
  - id: input_bam
    type:
      - 'null'
      - type: array
        items: File
    doc: Path to the input BAM(.bam)/CRAM(.cram) file(s). If using multiple samples,
      you can input multiple files.If just computing k-mer features, a BAM file is
      not needed.
    inputBinding:
      position: 1
      prefix: --input-bam
  - id: abundance
    type:
      - 'null'
      - type: array
        items: File
    doc: Path to the abundance file from strobealign-aemb. This can only be used when
      samples used in binning above or equal 5.
    inputBinding:
      position: 1
      prefix: --abundance
  - id: verbose
    type:
      - 'null'
      - boolean
    doc: Verbose output
    inputBinding:
      position: 1
      prefix: --verbose
  - id: quiet
    type:
      - 'null'
      - boolean
    doc: Quiet output
    inputBinding:
      position: 1
      prefix: --quiet
  - id: reference_db_data_dir
    type:
      - 'null'
      - Directory
    doc: 'GTDB reference storage path. (Default: $HOME/.cache/SemiBin/mmseqs2-GTDB).If
      not set --reference-db and SemiBin cannot find GTDB in $HOME/.cache/SemiBin/mmseqs2-GTDB,
      SemiBin will download GTDB (Note that >100GB of disk space are required).'
    inputBinding:
      position: 1
      prefix: --reference-db-data-dir
  - id: cannot_name
    type:
      - 'null'
      - string
    doc: 'Name for the cannot-link file (default: cannot).'
    inputBinding:
      position: 1
      prefix: --cannot-name
  - id: taxonomy_annotation_table
    type:
      - 'null'
      - type: array
        items: File
    doc: Pre-computed mmseqs2 format taxonomy TSV file to bypass mmseqs2 GTDB annotation
      [advanced]. When running with multi-sample binning, please make sure that the
      order of the taxonomy TSV file and the contig file (used for the combined fasta)
      is same.
    inputBinding:
      position: 1
      prefix: --taxonomy-annotation-table
  - id: epochs
    type:
      - 'null'
      - int
    doc: 'Number of epochs used in the training process (Default: 15).'
    inputBinding:
      position: 1
      prefix: --epochs
  - id: batch_size
    type:
      - 'null'
      - int
    doc: 'Batch size used in the training process (Default: 2048).'
    inputBinding:
      position: 1
      prefix: --batch-size
  - id: minfasta_kbs
    type:
      - 'null'
      - int
    doc: 'minimum bin size in Kbps (Default: 200).'
    inputBinding:
      position: 1
      prefix: --minfasta-kbs
  - id: random_seed
    type:
      - 'null'
      - int
    doc: Random seed. Set it to a fixed value to reproduce results across runs. The
      default is that the seed is set by the system and .
    inputBinding:
      position: 1
      prefix: --random-seed
  - id: ml_threshold
    type:
      - 'null'
      - int
    doc: Length threshold for generating must-link constraints. (By default, the threshold
      is calculated from the contig, and the default minimum value is 4,000 bp)
    inputBinding:
      position: 1
      prefix: --ml-threshold
  - id: engine
    type:
      - 'null'
      - string
    doc: device used to train the model (auto/gpu/cpu, auto means if SemiBin detects
      the gpu, SemiBin will use GPU)
    inputBinding:
      position: 1
      prefix: --engine
  - id: semi_supervised
    type:
      - 'null'
      - boolean
    doc: Train the model with semi-supervised learning.
    inputBinding:
      position: 1
      prefix: --semi-supervised
  - id: self_supervised
    type:
      - 'null'
      - boolean
    doc: Train the model with self-supervised learning.
    inputBinding:
      position: 1
      prefix: --self-supervised
  - id: sequencing_type
    type:
      - 'null'
      - string
    doc: 'sequencing type in [short_read/long_read], Default: short_read.'
    inputBinding:
      position: 1
      prefix: --sequencing-type
  - id: input_fasta
    type: File
    doc: Path to the input fasta file.
    inputBinding:
      position: 1
      prefix: --input-fasta
  - id: output
    type: string
    doc: Output directory (will be created if non-existent)
    inputBinding:
      position: 1
      prefix: --output
  - id: max_edges
    type:
      - 'null'
      - int
    doc: 'The maximum number of edges that can be connected to one contig (Default:
      200).'
    inputBinding:
      position: 1
      prefix: --max-edges
  - id: max_node
    type:
      - 'null'
      - float
    doc: 'Fraction of contigs that considered to be binned (should be between 0 and
      1; default: 1).'
    inputBinding:
      position: 1
      prefix: --max-node
  - id: no_recluster
    type:
      - 'null'
      - boolean
    doc: Do not recluster bins.
    inputBinding:
      position: 1
      prefix: --no-recluster
outputs:
  - id: output_dir
    type: Directory
    doc: Output directory
    outputBinding:
      glob: $(inputs.output)
requirements:
  - class: InlineJavascriptRequirement
hints:
  - class: DockerRequirement
    dockerPull: quay.io/biocontainers/semibin:2.2.1--pyhdfd78af_0
