cwlVersion: v1.2
class: CommandLineTool
baseCommand:
  - radsex
  - distrib
label: radsex_distrib
doc: "Computes the distribution of markers between group1 and group2.\n\nTool homepage:\
  \ https://github.com/SexGenomicsToolkit/radsex"
inputs:
  - id: markers_table
    type: File
    doc: Path to a marker depths table generated by "process"
    inputBinding:
      position: 101
      prefix: --markers-table
  - id: popmap
    type: File
    doc: Path to a tabulated file specifying groups for all individuals (population
      map)
    inputBinding:
      position: 101
      prefix: --popmap
  - id: min_depth
    type:
      - 'null'
      - int
    doc: Minimum depth to consider a marker present in an individual (default 1)
    inputBinding:
      position: 101
      prefix: --min-depth
  - id: groups
    type:
      - 'null'
      - string
    doc: Names of the groups to compare if there are more than two groups in the popmap
      (group1,group2)
    inputBinding:
      position: 101
      prefix: --groups
  - id: signif_threshold
    type:
      - 'null'
      - float
    doc: P-value threshold to consider a marker significantly associated with a phenotypic
      group (default 0.05)
    inputBinding:
      position: 101
      prefix: --signif-threshold
  - id: disable_correction
    type:
      - 'null'
      - boolean
    doc: If set, Bonferroni correction will NOT be used when assessing significance
      of association with phenotypic group
    inputBinding:
      position: 101
      prefix: --disable-correction
  - id: output_file_path
    type: string
    doc: Path to the output file (distribution of markers between groups)
    inputBinding:
      position: 102
      prefix: --output-file
outputs:
  - id: output_file
    type: File
    doc: Path to the output file (distribution of markers between groups)
    outputBinding:
      glob: $(inputs.output_file_path)
hints:
  - class: DockerRequirement
    dockerPull: quay.io/biocontainers/radsex:1.2.0--h43eeafb_3
