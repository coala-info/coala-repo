cwlVersion: v1.2
class: CommandLineTool
baseCommand:
  - MuSE
  - sump
label: muse_MuSE_sump
doc: "Summarize MuSE variant calls. Usage: MuSE sump [options]\n\nTool homepage:
  http://bioinformatics.mdanderson.org/main/MuSE"
inputs:
  - id: input_file
    type: File
    doc: single input file generated by 'MuSE call'
    inputBinding:
      position: 1
      prefix: -I
  - id: whole_genome
    type:
      - 'null'
      - boolean
    doc: input generated from whole genome sequencing data
    inputBinding:
      position: 2
      prefix: -G
  - id: whole_exome
    type:
      - 'null'
      - boolean
    doc: input generated from whole exome sequencing data
    inputBinding:
      position: 3
      prefix: -E
  - id: output_file_name
    type: string
    doc: output file name (VCF format)
    inputBinding:
      position: 4
      prefix: -O
  - id: cores
    type:
      - 'null'
      - int
    doc: number of cores specified
    inputBinding:
      position: 5
      prefix: -n
  - id: dbSNP_vcf
    type: File
    doc: dbSNP vcf file that should be bgzip compressed, tabix indexed and based
      on the same reference genome used in 'MuSE call' (required; sump crashes without it)
    secondaryFiles:
      - .tbi
    inputBinding:
      position: 6
      prefix: -D
outputs:
  - id: output_file
    type: File
    doc: output VCF file
    outputBinding:
      glob: $(inputs.output_file_name)
requirements:
  - class: InlineJavascriptRequirement
hints:
  - class: DockerRequirement
    dockerPull: quay.io/biocontainers/muse:2.1.2--h3b3e331_3
