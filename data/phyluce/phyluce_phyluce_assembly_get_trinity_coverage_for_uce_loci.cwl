cwlVersion: v1.2
class: CommandLineTool
baseCommand: phyluce_assembly_get_trinity_coverage_for_uce_loci
label: phyluce_phyluce_assembly_get_trinity_coverage_for_uce_loci
doc: "Given the input file generated by get_trinity_coverage, extract the values for UCE loci\n\nTool homepage: https://github.com/faircloth-lab/phyluce"
requirements:
  - class: InlineJavascriptRequirement
  - class: InitialWorkDirRequirement
    listing: "${ return inputs.resume ? [{entry: inputs.resume, writable: true}] : []; }"
inputs:
  - id: assemblies
    type: Directory
    doc: "The directory containing the assemblies"
    inputBinding:
      position: 1
      prefix: --assemblies
  - id: match_count_output
    type: File
    doc: "The output file containing taxa and loci in complete/incomplete matrices generated by get_match_counts.py."
    inputBinding:
      position: 1
      prefix: --match-count-output
  - id: type
    type: string
    doc: "Whether to compute stats on trimmed or untrimmed UCE data (trimmed or untrimmed)."
    inputBinding:
      position: 1
      prefix: --type
  - id: exclude
    type:
      - 'null'
      - {"type": "array", "items": "string"}
    doc: "A list of assemblies to ignore."
    inputBinding:
      position: 1
      prefix: --exclude
  - id: locus_db
    type: File
    doc: "The SQL database file holding probe matches to targeted loci (usually \"lastz/probe.matches.sqlite\")."
    inputBinding:
      position: 1
      prefix: --locus-db
  - id: output
    type:
      - 'null'
      - string
    doc: "The output directory to hold the UCE coverage files (use this or --resume)."
    inputBinding:
      position: 1
      prefix: --output
  - id: resume
    type:
      - 'null'
      - Directory
    doc: "The output directory in which to resume after a failure. It is staged writable."
    inputBinding:
      position: 1
      prefix: --resume
      valueFrom: $(self.basename)
  - id: verbosity
    type:
      - 'null'
      - string
    doc: "The logging level to use (INFO, WARN or CRITICAL)."
    inputBinding:
      position: 1
      prefix: --verbosity
  - id: log_path
    type:
      - 'null'
      - string
    doc: "The path to a directory to hold logs. The directory must already exist."
    inputBinding:
      position: 1
      prefix: --log-path
outputs:
  - id: stdout
    type: stdout
    doc: "Standard output, including the log messages."
  - id: output_dir
    type:
      - 'null'
      - Directory
    doc: "The output directory holding the UCE coverage files"
    outputBinding:
      glob: $(inputs.output)
hints:
  - class: DockerRequirement
    dockerPull: quay.io/biocontainers/phyluce:1.6.8--py_0
stdout: phyluce_phyluce_assembly_get_trinity_coverage_for_uce_loci.out
