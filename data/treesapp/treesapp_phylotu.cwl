cwlVersion: v1.2
class: CommandLineTool
baseCommand: [treesapp, phylotu]
label: treesapp_phylotu
doc: "A tool for sorting query sequences placed on a phylogeny into phylogenetically-inferred clusters.\n\nTool homepage: https://github.com/hallamlab/TreeSAPP"
inputs:
  - id: refpkg_path
    type:
      - 'null'
      - File
    doc: "Path to the reference package pickle (.pkl) file."
    inputBinding:
      position: 101
      prefix: --refpkg_path
  - id: refpkg_name
    type:
      - 'null'
      - string
    doc: "Name of the reference package to use, by its 'prefix' attribute, from the set packaged with TreeSAPP."
    inputBinding:
      position: 101
      prefix: --refpkg_name
  - id: output
    type:
      - 'null'
      - string
    doc: "Path to an output directory [DEFAULT = ./output/]"
    default: output
    inputBinding:
      position: 101
      prefix: --output
  - id: jplace
    type:
      - 'null'
      - type: array
        items: File
    doc: "Path to one or more JPlace files generated by placement on a reference package phylogeny."
    inputBinding:
      position: 101
      prefix: --jplace
  - id: assign_output
    type:
      - 'null'
      - type: array
        items: Directory
    doc: "Path to one or more output directories of treesapp assign."
    inputBinding:
      position: 101
      prefix: --assign_output
  - id: mode
    type:
      - 'null'
      - string
    doc: "Phylogenetic clustering mode: de_novo, ref_guided or local. [ DEFAULT = ref_guided ]"
    inputBinding:
      position: 101
      prefix: --mode
  - id: pre_cluster
    type:
      - 'null'
      - string
    doc: "Pre-clustering method: psc (placement space) or align (pairwise alignment). [ DEFAULT = psc ]"
    inputBinding:
      position: 101
      prefix: --pre_cluster
  - id: tax_rank
    type:
      - 'null'
      - string
    doc: "Taxonomic rank the cluster radius should represent: class, order, family, genus or species. [ DEFAULT = species ]"
    inputBinding:
      position: 101
      prefix: --tax_rank
  - id: alpha
    type:
      - 'null'
      - float
    doc: "The evolutionary distance threshold defining the cluster boundaries. [ DEFAULT = auto ]"
    inputBinding:
      position: 101
      prefix: --alpha
  - id: sample_regex
    type:
      - 'null'
      - string
    doc: "A regular expression for parsing the sample name from a query sequence name."
    inputBinding:
      position: 101
      prefix: --sample_regex
  - id: centroid_proportion
    type:
      - 'null'
      - float
    doc: "The proportion of the reference package profile HMM a candidate centroid must exceed. [ DEFAULT = 0.6 ]"
    inputBinding:
      position: 101
      prefix: --centroid_proportion
  - id: overwrite
    type:
      - 'null'
      - boolean
    doc: "Overwrites previously written output files and directories"
    inputBinding:
      position: 101
      prefix: --overwrite
  - id: verbose
    type:
      - 'null'
      - boolean
    doc: "Prints a more verbose runtime log"
    inputBinding:
      position: 101
      prefix: --verbose
  - id: num_procs
    type:
      - 'null'
      - int
    doc: "The number of CPU threads or parallel processes to use in various pipeline steps [ DEFAULT = 2 ]"
    inputBinding:
      position: 101
      prefix: --num_procs
  - id: delete
    type:
      - 'null'
      - boolean
    doc: "Delete all intermediate files to save disk space."
    inputBinding:
      position: 101
      prefix: --delete
outputs:
  - id: output_dir
    type:
      - 'null'
      - Directory
    doc: "Phylogenetic cluster output directory"
    outputBinding:
      glob: $(inputs.output)
requirements:
  - class: InlineJavascriptRequirement
hints:
  - class: DockerRequirement
    dockerPull: quay.io/biocontainers/treesapp:0.11.4--py39h2de1943_2
