cwlVersion: v1.2
class: CommandLineTool
baseCommand:
  - Barcode_split
label: pycoqc_Barcode_split
doc: "Barcode_split is a simple tool to split sequencing summary report in per barcodes.\n\nTool homepage: https://github.com/a-slide/pycoQC"
inputs:
  - id: summary_file
    type:
      type: array
      items: File
    doc: "Path to a sequencing_summary generated by Albacore 1.0.0+ / Guppy 2.1.3+. One can also pass multiple files."
    inputBinding:
      position: 1
      prefix: --summary_file
  - id: barcode_file
    type:
      - 'null'
      - type: array
        items: File
    doc: "Path to the barcode_file generated by Guppy 2.1.3+ (guppy_barcoder) or Deepbinner 0.2.0+."
    inputBinding:
      position: 1
      prefix: --barcode_file
  - id: output_dir
    type: string
    doc: "Folder where to output split barcode data."
    inputBinding:
      position: 1
      prefix: --output_dir
  - id: output_unclassified
    type:
      - 'null'
      - boolean
    doc: "If given, unclassified barcodes are also written in a file. By default they are skiped."
    inputBinding:
      position: 1
      prefix: --output_unclassified
  - id: min_barcode_percent
    type:
      - 'null'
      - float
    doc: "Minimal percent of total reads to retain barcode label. If below, the barcode value is set as `unclassified` (default: 0.1)"
    inputBinding:
      position: 1
      prefix: --min_barcode_percent
  - id: verbose
    type:
      - 'null'
      - boolean
    doc: "Increase verbosity."
    inputBinding:
      position: 1
      prefix: --verbose
  - id: quiet
    type:
      - 'null'
      - boolean
    doc: "Reduce verbosity."
    inputBinding:
      position: 1
      prefix: --quiet
outputs:
  - id: split_dir
    type: Directory
    doc: "Folder with the per barcode summary files."
    outputBinding:
      glob: $(inputs.output_dir)
requirements:
  - class: InlineJavascriptRequirement
  - class: InitialWorkDirRequirement
    listing:
      - entryname: $(inputs.output_dir)
        entry: "$({class: 'Directory', basename: inputs.output_dir, listing: []})"
        writable: true
hints:
  - class: DockerRequirement
    dockerPull: quay.io/biocontainers/pycoqc:2.5.2--py_0
