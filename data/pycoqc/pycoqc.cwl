cwlVersion: v1.2
class: CommandLineTool
baseCommand:
  - pycoQC
label: pycoqc
doc: "pycoQC computes metrics and generates interactive QC plots from the sequencing summary report generated by Oxford Nanopore technologies basecallers.\n\nTool homepage: https://github.com/a-slide/pycoQC"
inputs:
  - id: summary_file
    type:
      type: array
      items: File
    doc: "Path to a sequencing_summary generated by Albacore 1.0.0+ / Guppy 2.1.3+. One can also pass multiple files (Required)."
    inputBinding:
      position: 1
      prefix: --summary_file
  - id: barcode_file
    type:
      - 'null'
      - type: array
        items: File
    doc: "Path to the barcode_file generated by Guppy 2.1.3+ (guppy_barcoder) or Deepbinner 0.2.0+ (optional)."
    inputBinding:
      position: 1
      prefix: --barcode_file
  - id: bam_file
    type:
      - 'null'
      - type: array
        items: File
    doc: "Path to a Bam file corresponding to reads in the summary_file. Preferably aligned with Minimap2 (optional)."
    inputBinding:
      position: 1
      prefix: --bam_file
  - id: html_outfile
    type:
      - 'null'
      - string
    doc: "Path to an output html file report (required if json_outfile not given)."
    inputBinding:
      position: 1
      prefix: --html_outfile
  - id: json_outfile
    type:
      - 'null'
      - string
    doc: "Path to an output json file report (required if html_outfile not given)."
    inputBinding:
      position: 1
      prefix: --json_outfile
  - id: min_pass_qual
    type:
      - 'null'
      - int
    doc: "Minimum quality to consider a read as pass (default: 7)."
    inputBinding:
      position: 1
      prefix: --min_pass_qual
  - id: min_pass_len
    type:
      - 'null'
      - int
    doc: "Minimum read length to consider a read as pass (default: 0)."
    inputBinding:
      position: 1
      prefix: --min_pass_len
  - id: filter_calibration
    type:
      - 'null'
      - boolean
    doc: "If given, reads flagged as calibration strand by the basecaller are removed (default: False)."
    inputBinding:
      position: 1
      prefix: --filter_calibration
  - id: filter_duplicated
    type:
      - 'null'
      - boolean
    doc: "If given, duplicated read_ids are removed but the first occurence is kept (default: False)."
    inputBinding:
      position: 1
      prefix: --filter_duplicated
  - id: min_barcode_percent
    type:
      - 'null'
      - float
    doc: "Minimal percent of total reads to retain barcode label. If below, the barcode value is set as `unclassified` (default: 0.1)"
    inputBinding:
      position: 1
      prefix: --min_barcode_percent
  - id: report_title
    type:
      - 'null'
      - string
    doc: "Title to use in the html report (default: PycoQC report)."
    inputBinding:
      position: 1
      prefix: --report_title
  - id: template_file
    type:
      - 'null'
      - File
    doc: "Jinja2 html template for the html report."
    inputBinding:
      position: 1
      prefix: --template_file
  - id: config_file
    type:
      - 'null'
      - File
    doc: "Path to a JSON configuration file for the html report."
    inputBinding:
      position: 1
      prefix: --config_file
  - id: skip_coverage_plot
    type:
      - 'null'
      - boolean
    doc: "Skip the coverage plot in HTML report. Useful when using a reference file containing many sequences (default: False)."
    inputBinding:
      position: 1
      prefix: --skip_coverage_plot
  - id: sample
    type:
      - 'null'
      - int
    doc: "Number of reads randomly selected for plotting functions instead of the entire dataset (default: 100000)."
    inputBinding:
      position: 1
      prefix: --sample
  - id: default_config
    type:
      - 'null'
      - boolean
    doc: "Print default configuration file. Can be used to generate a template JSON file (default: False)."
    inputBinding:
      position: 1
      prefix: --default_config
  - id: verbose
    type:
      - 'null'
      - boolean
    doc: "Increase verbosity."
    inputBinding:
      position: 1
      prefix: --verbose
  - id: quiet
    type:
      - 'null'
      - boolean
    doc: "Reduce verbosity."
    inputBinding:
      position: 1
      prefix: --quiet
outputs:
  - id: html_report
    type:
      - 'null'
      - File
    doc: "HTML report."
    outputBinding:
      glob: $(inputs.html_outfile)
  - id: json_report
    type:
      - 'null'
      - File
    doc: "JSON report."
    outputBinding:
      glob: $(inputs.json_outfile)
  - id: stdout
    type: stdout
    doc: Standard output (default configuration with default_config).
requirements:
  - class: InlineJavascriptRequirement
hints:
  - class: DockerRequirement
    dockerPull: quay.io/biocontainers/pycoqc:2.5.2--py_0
stdout: pycoqc.out
