cwlVersion: v1.2
class: CommandLineTool
baseCommand:
  - radsex
  - freq
label: radsex_freq
doc: "Computes marker frequencies in all individuals.\n\nTool homepage: https://github.com/SexGenomicsToolkit/radsex"
inputs:
  - id: markers_table
    type: File
    doc: Path to a marker depths table generated by "process"
    inputBinding:
      position: 101
      prefix: --markers-table
  - id: min_depth
    type:
      - 'null'
      - int
    doc: Minimum depth to consider a marker present in an individual (default 1)
    inputBinding:
      position: 101
      prefix: --min-depth
  - id: output_file_path
    type: string
    doc: Path to the output file (distribution of marker frequencies in all individuals)
    inputBinding:
      position: 102
      prefix: --output-file
outputs:
  - id: output_file
    type: File
    doc: Path to the output file (distribution of marker frequencies in all individuals)
    outputBinding:
      glob: $(inputs.output_file_path)
hints:
  - class: DockerRequirement
    dockerPull: quay.io/biocontainers/radsex:1.2.0--h43eeafb_3
