cwlVersion: v1.2
class: CommandLineTool
baseCommand:
  - scanpy-cli
  - multiplet
  - scrublet
label: scanpy-scripts_scanpy-cli_multiplet_scrublet
doc: "Filter out likely multiplets from droplet data using Scrublet [Wolock2019].\n\nTool homepage: https://github.com/ebi-gene-expression-group/scanpy-scripts"
inputs:
  - id: input_obj
    type: File
    doc: input file in format specified by --input-format
    inputBinding:
      position: 1
  - id: output_obj_path
    type: string
    doc: output file in format specified by --output-format
    inputBinding:
      position: 2
  - id: input_format
    type:
      - 'null'
      - string
    doc: "Input object format."
    inputBinding:
      position: 101
      prefix: --input-format
  - id: output_format
    type:
      - 'null'
      - string
    doc: "Output object format."
    inputBinding:
      position: 101
      prefix: --output-format
  - id: zarr_chunk_size
    type:
      - 'null'
      - int
    doc: "Chunk size for writing output in zarr format."
    inputBinding:
      position: 101
      prefix: --zarr-chunk-size
  - id: loom_write_obsm_varm
    type:
      - 'null'
      - boolean
    doc: "Write obsm and varm to the Loom file?"
    inputBinding:
      position: 101
      prefix: --loom-write-obsm-varm
  - id: export_mtx_path
    type:
      - 'null'
      - string
    doc: "When specified, using it as prefix for exporting mtx files. If not empty and not ending with \"/\" or \"_\", a \"_\" will be appended."
    inputBinding:
      position: 101
      prefix: --export-mtx
  - id: mtx_compression
    type:
      - 'null'
      - string
    doc: "Compression type for MTX output."
    inputBinding:
      position: 101
      prefix: --mtx-compression
  - id: show_obj
    type:
      - 'null'
      - string
    doc: "Print output object summary info to specified stream."
    inputBinding:
      position: 101
      prefix: --show-obj
  - id: batch_key
    type:
      - 'null'
      - string
    doc: "The name of the column in adata.obs that differentiates among experiments/batches. Doublets will be detected in each batch separately."
    inputBinding:
      position: 101
      prefix: --batch-key
  - id: input_obj_sim
    type:
      - 'null'
      - File
    doc: "(Advanced use case) Optional annData object generated by sc.external.pp.scrublet_simulate_doublets(), with same number of vars as adata. This should have been built from input_obj after filtering genes and cells and selcting highly-variable genes."
    inputBinding:
      position: 101
      prefix: --input-obj-sim
  - id: threshold
    type:
      - 'null'
      - float
    doc: "Doublet score threshold for calling a transcriptome a doublet. If not set, this is set automatically by looking for the minimum between the two modes of the doublet_scores_sim_ histogram. It is best practice to check the threshold visually using the doublet_scores_sim_ histogram and/or based on co-localization of predicted doublets in a 2-D embedding."
    inputBinding:
      position: 101
      prefix: --threshold
  - id: sim_doublet_ratio
    type:
      - 'null'
      - float
    doc: "Number of doublets to simulate relative to the number of observed transcriptomes."
    inputBinding:
      position: 101
      prefix: --sim-doublet-ratio
  - id: synthetic_doublet_umi_subsampling
    type:
      - 'null'
      - float
    doc: "Where input_obj_sim not suplied, rate for sampling UMIs when creating synthetic doublets. If 1.0, each doublet is created by simply adding the UMI counts from two randomly sampled observed transcriptomes. For values less than 1, the UMI counts are added and then randomly sampled at the specified rate."
    inputBinding:
      position: 101
      prefix: --synthetic-doublet-umi-subsampling
  - id: expected_doublet_rate
    type:
      - 'null'
      - float
    doc: "Where input_obj_sim not suplied, the estimated doublet rate for the experiment."
    inputBinding:
      position: 101
      prefix: --expected-doublet-rate
  - id: stdev_doublet_rate
    type:
      - 'null'
      - float
    doc: "Where input_obje_sim not suplied, uncertainty in the expected doublet rate."
    inputBinding:
      position: 101
      prefix: --stdev-doublet-rate
  - id: knn_dist_metric
    type:
      - 'null'
      - string
    doc: "A known metric’s name."
    inputBinding:
      position: 101
      prefix: --knn-dist-metric
  - id: no_normalize_variance
    type:
      - 'null'
      - boolean
    doc: "Default is to normalize the data such that each gene has a variance of 1. sklearn.decomposition.TruncatedSVD will be used for dimensionality reduction, if --no- mean-center is set. Use this flag to disable that behaviour."
    inputBinding:
      position: 101
      prefix: --no-normalize-variance
  - id: log_transform
    type:
      - 'null'
      - boolean
    doc: "Whether to use :func:~scanpy.pp.log1p to log-transform the data prior to PCA."
    inputBinding:
      position: 101
      prefix: --log-transform
  - id: no_mean_center
    type:
      - 'null'
      - boolean
    doc: "If True, center the data such that each gene has a mean of 0. sklearn.decomposition.PCA will be used for dimensionality reduction."
    inputBinding:
      position: 101
      prefix: --no-mean-center
  - id: n_pcs
    type:
      - 'null'
      - int
    doc: "Number of principal components used to embed the transcriptomes prior to k-nearest- neighbor graph construction."
    inputBinding:
      position: 101
      prefix: --n-pcs
  - id: no_approx
    type:
      - 'null'
      - boolean
    doc: "Default behaviour is to use the approximate nearest neighbor method (annoy) for the KNN classifier. Use this flag to disable that behaviour."
    inputBinding:
      position: 101
      prefix: --no-approx
  - id: get_doublet_neighbor_parents
    type:
      - 'null'
      - boolean
    doc: "If set, return (in .uns) the parent transcriptomes that generated the doublet neighbors of each observed transcriptome. This information can be used to infer the cell states that generated a given doublet state."
    inputBinding:
      position: 101
      prefix: --get-doublet-neighbor-parents
  - id: n_neighbors
    type:
      - 'null'
      - type: array
        items: int
    doc: "Number of neighbors used to construct the KNN graph of observed transcriptomes and simulated doublets. If not set, this is automatically set to np.round(0.5 * np.sqrt(n_obs))."
    inputBinding:
      position: 101
      prefix: --n-neighbors
      itemSeparator: ','
  - id: filter
    type:
      - 'null'
      - boolean
    doc: "By default, the output object is annotated but not filtered according to the scrublet status. Setting this flag will cause predicted multiplet elements to be removed."
    inputBinding:
      position: 101
      prefix: --filter
  - id: no_verbose
    type:
      - 'null'
      - boolean
    doc: "Default behaviour is to print progress updates. Use this flag to disable that."
    inputBinding:
      position: 101
      prefix: --no-verbose
  - id: export_table_path
    type:
      - 'null'
      - string
    doc: "Export a table of double scores and calls to the specified file."
    inputBinding:
      position: 101
      prefix: --export-table
  - id: random_state
    type:
      - 'null'
      - int
    doc: "Seed for random number generator."
    inputBinding:
      position: 101
      prefix: --random-state
outputs:
  - id: output_obj
    type:
      - File
      - Directory
    doc: output object (a directory for the zarr format)
    outputBinding:
      glob: $(inputs.output_obj_path)
  - id: export_mtx
    type:
      type: array
      items: File
    doc: "When specified, using it as prefix for exporting mtx files. If not empty and not ending with \"/\" or \"_\", a \"_\" will be appended. (files written with the given prefix)"
    outputBinding:
      glob: $(inputs.export_mtx_path)*
  - id: export_table
    type:
      - 'null'
      - File
    doc: "Export a table of double scores and calls to the specified file."
    outputBinding:
      glob: $(inputs.export_table_path)
requirements:
  - class: InlineJavascriptRequirement
hints:
  - class: DockerRequirement
    dockerPull: quay.io/biocontainers/scanpy-scripts:1.9.301--pyhdfd78af_0
