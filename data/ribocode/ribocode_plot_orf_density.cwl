cwlVersion: v1.2
class: CommandLineTool
baseCommand: plot_orf_density
label: ribocode_plot_orf_density
doc: "This script is designed for plot the P-site profile of specified ORF.\n\nTool
  homepage: https://github.com/xryanglab/RiboCode"
inputs:
  - id: annot_dir
    type: Directory
    doc: transcripts annotation directory, generated by prepare_transcripts.
    inputBinding:
      position: 101
      prefix: --annot_dir
      valueFrom: $(self.basename)
  - id: alignment_files
    type:
      type: array
      items: File
    doc: Transcriptome BAM/SAM files named in the config file; staged in the working
      directory, so give the file names only (no directory) in the config file.
  - id: psites_hd5
    type:
      type: array
      items: File
    doc: P-site density files (<sample>_psites.hd5) written by RiboCode; staged in
      the working directory.
  - id: config_file
    type: File
    doc: define bam file information in this file, please refer to the example 
      file in data folder.
    inputBinding:
      position: 101
      prefix: --config_file
  - id: transcript_id
    type: string
    doc: the transcript id
    inputBinding:
      position: 101
      prefix: --transcript_id
  - id: orf_tstart
    type: int
    doc: transcript-level coordinates of start of ORF (orf_tstart)
    inputBinding:
      position: 101
      prefix: --orf_tstart
  - id: orf_tstop
    type: int
    doc: transcript-level coordinates of end of ORF (orf_tstop)
    inputBinding:
      position: 101
      prefix: --orf_tstop
  - id: start_codon
    type: string
    doc: start codon of predicted ORFs
    inputBinding:
      position: 101
      prefix: --start-codon
  - id: outname
    type:
      - 'null'
      - string
    doc: output file name, default is transcriptid_tstart_tstop.pdf
    inputBinding:
      position: 101
      prefix: --outname
  - id: plot_annotated_orf
    type:
      - 'null'
      - string
    doc: plot the annotated orf (yes) or not (no).
    inputBinding:
      position: 101
      prefix: --plot-annotated-orf
outputs:
  - id: density_plot
    type:
      type: array
      items: File
    doc: P-site profile plot of the ORF
    outputBinding:
      glob: '*.pdf'
  - id: stdout
    type: stdout
    doc: Standard output
requirements:
  - class: InlineJavascriptRequirement
  - class: InitialWorkDirRequirement
    listing:
      - entry: $(inputs.annot_dir)
        writable: true
      - $(inputs.alignment_files)
      - $(inputs.psites_hd5)
hints:
  - class: DockerRequirement
    dockerPull: quay.io/biocontainers/ribocode:1.2.15--pyhdc42f0e_1
stdout: ribocode_plot_orf_density.out
