cwlVersion: v1.2
class: CommandLineTool
baseCommand: panaroo-filter-pa
label: panaroo_filter_pa
doc: "Filter the Panaroo gene_presence_absence.csv file to exclude sequences classed as length outliers, pseudogenes or fragmented. The tool builds the output names from the input path, so the input file is staged in the working directory and given by its file name.

Tool homepage: https://gtonkinhill.github.io/panaroo"
requirements:
  - class: InlineJavascriptRequirement
  - class: InitialWorkDirRequirement
    listing:
      - entry: $(inputs.input)
      - entry: '$({"class": "Directory", "basename": inputs.out_dir, "listing": []})'
        writable: true
inputs:
  - id: input
    type: File
    doc: "Input 'gene_presence_absence.csv' file generated by Panaroo."
    inputBinding:
      prefix: --input
      valueFrom: "$(self.basename)"
  - id: out_dir
    type: string
    doc: "Location of an output directory."
    inputBinding:
      prefix: --out_dir
  - id: type
    type:
      - 'null'
      - string
    doc: "Any combination of 'pseudo', 'length' or 'frag' separated by commas."
    inputBinding:
      prefix: --type
outputs:
  - id: output_dir
    type:
      - 'null'
      - Directory
    doc: "Output directory with the filtered presence/absence file."
    outputBinding:
      glob: $(inputs.out_dir)
  - id: stdout
    type: stdout
    doc: Standard output
hints:
  - class: DockerRequirement
    dockerPull: quay.io/biocontainers/panaroo:1.6.0--pyhdfd78af_0
stdout: panaroo_filter_pa.out
