cwlVersion: v1.2
class: CommandLineTool
baseCommand: multievolve.py
label: phylowgs_multievolve.py
doc: "Concurrently run multiple MCMC chains of PhyloWGS. All options that
  evolve.py accepts may also be specified here.\n\nTool homepage:
  https://github.com/morrislab/phylowgs"
inputs:
  - id: ssms
    type: File
    doc: File listing SSMs (simple somatic mutations, i.e., single nucleotide
      variants. For proper format, see README.md.
    inputBinding:
      position: 1
      prefix: --ssms
  - id: cnvs
    type: File
    doc: File listing CNVs (copy number variations). For proper format, see
      README.md.
    inputBinding:
      position: 1
      prefix: --cnvs
  - id: num_chains
    type: ['null', int]
    doc: Number of chains to run concurrently
    inputBinding:
      position: 1
      prefix: --num-chains
  - id: random_seeds
    type:
      - 'null'
      - int[]
    doc: Random seeds with which to initialize each chain. Specify one for each
      chain.
    inputBinding:
      position: 1
      prefix: --random-seeds
  - id: chain_inclusion_factor
    type: ['null', float]
    doc: Factor for determining which chains will be included in the output
      "merged" folder.
    inputBinding:
      position: 1
      prefix: --chain-inclusion-factor
  - id: output_dir
    type: ['null', string]
    default: chains
    doc: Directory where results from each chain will be saved.
    inputBinding:
      position: 1
      prefix: --output-dir
  - id: burnin_samples
    type: ['null', int]
    doc: Number of burnin samples (passed to evolve.py)
    inputBinding:
      position: 2
      prefix: --burnin-samples
  - id: mcmc_samples
    type: ['null', int]
    doc: Number of MCMC samples (passed to evolve.py)
    inputBinding:
      position: 2
      prefix: --mcmc-samples
  - id: mh_iterations
    type: ['null', int]
    doc: Number of Metropolis-Hastings iterations (passed to evolve.py)
    inputBinding:
      position: 2
      prefix: --mh-iterations
  - id: write_backups_every
    type: ['null', int]
    doc: Number of iterations between backups of program state (passed to
      evolve.py)
    inputBinding:
      position: 2
      prefix: --write-backups-every
  - id: write_state_every
    type: ['null', int]
    doc: Number of iterations between writing program state to disk (passed to
      evolve.py)
    inputBinding:
      position: 2
      prefix: --write-state-every
  - id: tmp_dir
    type: ['null', string]
    doc: Path to directory for temporary files (passed to evolve.py)
    inputBinding:
      position: 2
      prefix: --tmp-dir
  - id: params_file
    type: ['null', File]
    doc: JSON file listing run parameters, generated by the parser (passed to
      evolve.py)
    inputBinding:
      position: 2
      prefix: --params
outputs:
  - id: chains_dir
    type: Directory
    doc: Directory with the results of each chain and the merged results
    outputBinding:
      glob: $(inputs.output_dir)
hints:
  - class: DockerRequirement
    dockerPull: quay.io/biocontainers/phylowgs:20181105--py27ha7db03b_3
