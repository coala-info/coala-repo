cwlVersion: v1.2
class: CommandLineTool
baseCommand: Plot.R
label: strainr2_Plot.R
doc: "Plot.R normalizes the StrainR read counts (PREFIX.rpkm) with the PreProcessR k-mer report and writes the abundances, a plot and an abundance summary into the abundance directory.\n\nTool homepage: https://github.com/BisanzLab/StrainR2"
inputs:
  - id: abundances
    type: Directory
    doc: abundance directory generated by StrainR (holds PREFIX.rpkm); the results are written into a copy of it
    inputBinding:
      position: 101
      prefix: -a
      valueFrom: $(self.basename)
  - id: indir
    type: Directory
    doc: directory outputted by PreProcessR
    inputBinding:
      position: 102
      prefix: -i
  - id: prefix
    type: string
    doc: the same prefix as used by StrainR
    inputBinding:
      position: 103
      prefix: -p
  - id: weighted_percentile
    type:
      - 'null'
      - float
    doc: Weighted percentile for a strain's FUKMs to use in abundance estimation
    inputBinding:
      position: 104
      prefix: -c
  - id: subcontig_filter
    type:
      - 'null'
      - float
    doc: Percentage of a strain's subcontigs that should be filtered out based on number of unique k-mers
    inputBinding:
      position: 105
      prefix: -s
outputs:
  - id: abundances_out
    type: Directory
    doc: abundance directory with the new PREFIX.abundances, PREFIX.pdf and PREFIX_abundance_summary.tsv
    outputBinding:
      glob: $(inputs.abundances.basename)
requirements:
  - class: InlineJavascriptRequirement
  - class: InitialWorkDirRequirement
    listing:
      - entry: $(inputs.abundances)
        writable: true
hints:
  - class: DockerRequirement
    dockerPull: quay.io/biocontainers/strainr2:2.3.0--r44h577a1d6_0
