cwlVersion: v1.2
class: CommandLineTool
baseCommand:
  - novoindex
label: novoalign_novoindex
doc: "Universal k-mer index constructor for Novoalign.\n\nTool homepage: http://www.novocraft.com/products/novoalign/"
inputs:
  - id: kmer_length
    type:
      - 'null'
      - int
    doc: The k-mer length to be used for the index. Typically 14.
    inputBinding:
      position: 1
      prefix: -k
  - id: step_size
    type:
      - 'null'
      - int
    doc: The step size for the index. Typical values are from 1 to 3.
    inputBinding:
      position: 2
      prefix: -s
  - id: threads
    type:
      - 'null'
      - int
    doc: Number of threads to use for indexing.
    inputBinding:
      position: 3
      prefix: -t
  - id: mask_lowercase
    type:
      - 'null'
      - boolean
    doc: Lower case masking on. Lower case sequence will not be indexed.
    inputBinding:
      position: 4
      prefix: -m
  - id: bisulphite
    type:
      - 'null'
      - boolean
    doc: Bisulphite indexing and alignment mode for methylation experiments.
    inputBinding:
      position: 5
      prefix: -b
  - id: add_m5_tag
    type:
      - 'null'
      - boolean
    doc: Add an M5 tag to sequence headers.
    inputBinding:
      position: 6
      prefix: '-5'
  - id: index_name
    type:
      - 'null'
      - string
    doc: An internal name for the reference sequence index. Used in report
      headers and as the AS field in the SAM SQ record. Defaults to the index
      file name.
    inputBinding:
      position: 7
      prefix: -n
  - id: indexfile
    type: string
    doc: File name for the indexed reference sequence generated by novoindex.
    inputBinding:
      position: 8
  - id: sequencefiles
    type:
      type: array
      items: File
    doc: A list of sequence files in fasta format to be included in the index.
    inputBinding:
      position: 9
outputs:
  - id: index
    type: File
    doc: Novoalign index file
    outputBinding:
      glob: $(inputs.indexfile)
  - id: log
    type: stderr
    doc: Index construction log written to standard error
hints:
  - class: DockerRequirement
    dockerPull: quay.io/biocontainers/novoalign:4.03.04--h43eeafb_3
stderr: novoalign_novoindex.log
