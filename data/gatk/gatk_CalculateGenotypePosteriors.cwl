cwlVersion: v1.2
class: CommandLineTool
baseCommand:
- gatk
- CalculateGenotypePosteriors
label: gatk_CalculateGenotypePosteriors
doc: |-
  This tool calculates the posterior genotype probability for each sample genotype in a VCF of input variant calls, based on the genotype likelihoods from the samples themselves and, optionally, from input VCFs describing allele frequencies in related populations. The input variants must possess genotype likelihoods generated by HaplotypeCaller, UnifiedGenotyper or another source that provides *unbiased* genotype likelihoods.

  Tool homepage: https://www.broadinstitute.org/gatk/
inputs:
- id: output
  type: string
  doc: File to which variants should be written
  inputBinding:
    prefix: --output
- id: variant
  type: File
  doc: A VCF file containing variants
  inputBinding:
    prefix: --variant
  secondaryFiles:
  - pattern: .idx
    required: false
  - pattern: .tbi
    required: false
- id: de_novo_prior
  type:
  - 'null'
  - double
  doc: 'Prior for de novo mutations Default value: 1.0E-6.'
  inputBinding:
    prefix: --de-novo-prior
- id: default_to_allele_count
  type:
  - 'null'
  - boolean
  doc: 'Use AC rather than MLEAC Default value: false. Possible values: {true, false}'
  inputBinding:
    prefix: --default-to-allele-count
    valueFrom: '$(self ? ''true'' : ''false'')'
- id: discovered_allele_count_priors_off
  type:
  - 'null'
  - boolean
  doc: 'Do not use discovered allele count in the input callset for variants that
    do not appear in the external callset. Default value: false. Possible values:
    {true, false}'
  inputBinding:
    prefix: --discovered-allele-count-priors-off
    valueFrom: '$(self ? ''true'' : ''false'')'
- id: exclude_intervals
  type:
  - 'null'
  - type: array
    items:
    - string
    - File
    inputBinding:
      prefix: --exclude-intervals
  doc: One or more genomic intervals to exclude from processing This argument may
    be specified 0 or more times.
- id: global_prior_indel
  type:
  - 'null'
  - double
  doc: 'Global Dirichlet prior parameters for the indel allele frequency Default value:
    0.001.'
  inputBinding:
    prefix: --global-prior-indel
- id: global_prior_snp
  type:
  - 'null'
  - double
  doc: 'Global Dirichlet prior parameters for the SNP allele frequency Default value:
    0.001.'
  inputBinding:
    prefix: --global-prior-snp
- id: ignore_input_samples
  type:
  - 'null'
  - boolean
  doc: 'Use external information only Default value: false. Possible values: {true,
    false}'
  inputBinding:
    prefix: --ignore-input-samples
    valueFrom: '$(self ? ''true'' : ''false'')'
- id: interval_padding
  type:
  - 'null'
  - int
  doc: 'Amount of padding (in bp) to add to each interval you are including. Default
    value: 0.'
  inputBinding:
    prefix: --interval-padding
- id: intervals
  type:
  - 'null'
  - type: array
    items:
    - string
    - File
    inputBinding:
      prefix: --intervals
  doc: One or more genomic intervals over which to operate This argument may be specified
    0 or more times.
- id: num_reference_samples_if_no_call
  type:
  - 'null'
  - int
  doc: 'Number of hom-ref genotypes to infer at sites not present in a panel Default
    value: 0.'
  inputBinding:
    prefix: --num-reference-samples-if-no-call
- id: pedigree
  type:
  - 'null'
  - File
  doc: Pedigree file for samples
  inputBinding:
    prefix: --pedigree
- id: reference
  type:
  - 'null'
  - File
  doc: Reference sequence
  inputBinding:
    prefix: --reference
  secondaryFiles:
  - pattern: .fai
    required: true
  - pattern: ^.dict
    required: true
- id: skip_family_priors
  type:
  - 'null'
  - boolean
  doc: 'Skip application of family-based priors Default value: false. Possible values:
    {true, false}'
  inputBinding:
    prefix: --skip-family-priors
    valueFrom: '$(self ? ''true'' : ''false'')'
- id: skip_population_priors
  type:
  - 'null'
  - boolean
  doc: 'Skip application of population-based priors Default value: false. Possible
    values: {true, false}'
  inputBinding:
    prefix: --skip-population-priors
    valueFrom: '$(self ? ''true'' : ''false'')'
- id: supporting_callsets
  type:
  - 'null'
  - type: array
    items: File
    inputBinding:
      prefix: --supporting-callsets
  doc: Other callsets to use in generating genotype posteriors This argument may be
    specified 0 or more times.
  secondaryFiles:
  - pattern: .idx
    required: false
  - pattern: .tbi
    required: false
- id: use_flat_priors_for_indels
  type:
  - 'null'
  - boolean
  doc: 'Use flat priors for indels Default value: false. Possible values: {true, false}'
  inputBinding:
    prefix: --use-flat-priors-for-indels
    valueFrom: '$(self ? ''true'' : ''false'')'
outputs:
- id: output_output
  type: File
  doc: File to which variants should be written
  outputBinding:
    glob: $(inputs.output)
  secondaryFiles:
  - pattern: .idx
    required: false
  - pattern: .tbi
    required: false
requirements:
- class: InlineJavascriptRequirement
hints:
- class: DockerRequirement
  dockerPull: broadinstitute/gatk:4.7.0.0
s:url: https://www.broadinstitute.org/gatk/
$namespaces:
  s: https://schema.org/
