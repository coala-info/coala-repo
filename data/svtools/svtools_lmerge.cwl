cwlVersion: v1.2
class: CommandLineTool
baseCommand:
  - svtools
  - lmerge
label: svtools_lmerge
doc: 'Merge variant calls in a VCF file sorted by svtools lsort.


  Tool homepage: https://github.com/hall-lab/svtools'
inputs:
  - id: input_vcf
    type:
      - 'null'
      - File
    doc: A sorted VCF file generated by svtools lsort. Each INFO field must contain
      an SNAME tag containing the sample name (e.g. SNAME=SAMPLE_NAME)
    inputBinding:
      position: 101
      prefix: --inFile
  - id: percent_slop
    type:
      - 'null'
      - double
    doc: Increase the breakpoint confidence interval both up and down stream by a
      given proportion of the original size
    inputBinding:
      position: 101
      prefix: --percent-slop
  - id: fixed_slop
    type:
      - 'null'
      - int
    doc: Increase the breakpoint confidence interval both up and down stream by a
      given fixed size
    inputBinding:
      position: 101
      prefix: --fixed-slop
  - id: sum
    type:
      - 'null'
      - boolean
    doc: Calculate breakpoint PDF and position using sum algorithm instead of product
    inputBinding:
      position: 101
      prefix: --sum
  - id: include_genotypes
    type:
      - 'null'
      - boolean
    doc: Include original genotypes in output. When multiple variants are merged,
      the last will dictate the genotype field
    inputBinding:
      position: 101
      prefix: -g
  - id: weighting
    type:
      - 'null'
      - string
    doc: 'Weighting scheme (intended for use in tiered merging), options: unweighted,
      carrier_wt, evidence_wt'
    inputBinding:
      position: 101
      prefix: -w
  - id: tempdir
    type:
      - 'null'
      - string
    doc: Directory for temp file downloads
    inputBinding:
      position: 101
      prefix: --tempdir
outputs:
  - id: out_vcf
    type: stdout
    doc: Merged VCF
requirements:
  - class: InlineJavascriptRequirement
hints:
  - class: DockerRequirement
    dockerPull: quay.io/biocontainers/svtools:0.5.1--py_0
stdout: svtools_lmerge.vcf
