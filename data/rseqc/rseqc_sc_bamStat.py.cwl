cwlVersion: v1.2
class: CommandLineTool
baseCommand: [sc_bamStat.py]
label: rseqc_sc_bamStat.py
doc: "Report single cell RNA-seq (scRNA-seq) read mapping statistics. It processes the BAM file generated by the Cell Ranger workflow.\n\nTool homepage: https://rseqc.sourceforge.net"
inputs:
  - id: infile
    type: File
    secondaryFiles:
      - pattern: .bai
        required: true
    doc: "Input file in BAM foramt. Must have BAM alignment tags indicated below."
    inputBinding:
      position: 1
      prefix: --infile
  - id: cb_tag
    type:
      - 'null'
      - string
    doc: "BAM alignment tag. Used to indicate error-corrected cellular barcode. default='CB'"
    inputBinding:
      position: 1
      prefix: --cb-tag
  - id: re_tag
    type:
      - 'null'
      - string
    doc: "BAM alignment tag. Used to indicate the region type of the alignment (E = exonic, N = intronic, I = intergenic). default='RE'"
    inputBinding:
      position: 1
      prefix: --re-tag
  - id: tx_tag
    type:
      - 'null'
      - string
    doc: "BAM alignment tag. Used to indicate reads aligned to the same strand as the annotated transcripts. default='TX'"
    inputBinding:
      position: 1
      prefix: --tx-tag
  - id: an_tag
    type:
      - 'null'
      - string
    doc: "BAM alignment tag. Used to indicate reads aligned to the antisense strand of the annotated transcripts. default='AN'"
    inputBinding:
      position: 1
      prefix: --an-tag
  - id: umi_tag
    type:
      - 'null'
      - string
    doc: "BAM alignment tag. Used to indicat the error-corrected UMI. default='UB'"
    inputBinding:
      position: 1
      prefix: --umi-tag
  - id: xf_tag
    type:
      - 'null'
      - string
    doc: "BAM alignment tag. Used to indicate reads confidently mapped to the feature. default='xf'"
    inputBinding:
      position: 1
      prefix: --xf-tag
  - id: chrm_id
    type:
      - 'null'
      - string
    doc: "The name of mitochondrial chromosome in BAM file. default='chrM'"
    inputBinding:
      position: 1
      prefix: --chrM-id
  - id: verbose
    type:
      - 'null'
      - boolean
    doc: "Logical to determine if detailed running information is printed to screen."
    inputBinding:
      position: 1
      prefix: --verbose
outputs:
  - id: stdout
    type: stdout
    doc: "Mapping statistics."
hints:
  - class: DockerRequirement
    dockerPull: quay.io/biocontainers/rseqc:5.0.4--pyhdfd78af_1
stdout: sc_bamStat.txt
s:url: https://rseqc.sourceforge.net
$namespaces:
  s: https://schema.org/
