cwlVersion: v1.2
class: CommandLineTool
baseCommand: convert-sam-for-rsem
label: rsem_convert-sam-for-rsem
doc: "Convert a SAM/BAM/CRAM file made by the user's aligner into a BAM file
  that RSEM can process, and validate it with rsem-sam-validator. The aligner
  must have used reference_name.idx.fa from rsem-prepare-reference as its
  reference and must have written the header section.\n\nTool homepage:
  https://deweylab.github.io/RSEM/"
inputs:
  - id: input_alignments
    type: File
    doc: The SAM/BAM/CRAM file generated by the user's aligner. It must contain 
      the header section.
    inputBinding:
      position: 1
  - id: output_file_name
    type: string
    doc: The output name for the converted file. A BAM with the name 
      output_file_name.bam is written.
    inputBinding:
      position: 2
  - id: num_threads
    type:
      - 'null'
      - int
    doc: 'Set the number of threads to be used for converting. (Default: 1)'
    inputBinding:
      position: 0
      prefix: --num-threads
  - id: memory_per_thread
    type:
      - 'null'
      - string
    doc: "Set the maximum allowable memory per thread. <string> represents the
      memory and accepts suffices 'K/M/G'. (Default: 1G)"
    inputBinding:
      position: 0
      prefix: --memory-per-thread
outputs:
  - id: converted_bam
    type: File
    outputBinding:
      glob: $(inputs.output_file_name).bam
    doc: The converted BAM file.
hints:
  - class: DockerRequirement
    dockerPull: quay.io/biocontainers/rsem:1.3.3--pl5321h077b44d_12
