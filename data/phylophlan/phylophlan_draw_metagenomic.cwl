cwlVersion: v1.2
class: CommandLineTool
baseCommand:
  - phylophlan_draw_metagenomic
label: phylophlan_draw_metagenomic
doc: "Takes the output table of the phylophlan metagenomic assignment and produces two heatmap figures: presence/absence of the SGBs in the metagenomic samples, and the amount of kSGB, uSGB and unassigned for each metagenome.\n\nTool homepage: https://github.com/biobakery/phylophlan"
inputs:
  - id: input
    type: File
    doc: "The input file generated by the SGB assignment script"
    inputBinding:
      position: 1
      prefix: "--input"
  - id: map
    type: File
    doc: "A mapping file that maps each bin to its metagenome"
    inputBinding:
      position: 2
      prefix: "--map"
  - id: top
    type:
      - 'null'
      - int
    doc: "Number of SGBs to display in the figure (default: 20)"
    inputBinding:
      position: 3
      prefix: "--top"
  - id: output
    type: string
    doc: "Prefix of the output files (default: output_heatmap)"
    default: "output_heatmap"
    inputBinding:
      position: 3
      prefix: "--output"
  - id: separator
    type:
      - 'null'
      - string
    doc: "Separator used in the mapping file"
    inputBinding:
      position: 3
      prefix: "--separator"
  - id: dpi
    type:
      - 'null'
      - int
    doc: "Dpi resolution of the images (default: 200)"
    inputBinding:
      position: 3
      prefix: "--dpi"
  - id: format
    type:
      - 'null'
      - string
    doc: "Images output format (default: svg)"
    inputBinding:
      position: 3
      prefix: "-f"
  - id: verbose
    type:
      - 'null'
      - boolean
    doc: "Prints more stuff"
    inputBinding:
      position: 3
      prefix: "--verbose"
outputs:
  - id: figures
    type:
      - 'null'
      - type: array
        items: File
    doc: "Heatmap figures"
    outputBinding:
      glob: "$(inputs.output)*"
  - id: stdout
    type: stdout
    doc: "Standard output"
requirements:
  - class: InlineJavascriptRequirement
hints:
  - class: DockerRequirement
    dockerPull: quay.io/biocontainers/phylophlan:3.2.1--pyhdfd78af_0
stdout: phylophlan_draw_metagenomic.out
