cwlVersion: v1.2
class: CommandLineTool
baseCommand: [NCBImetaAnnotate]
label: ncbimeta_NCBImetaAnnotate
doc: "NCBImeta annotation tool: replace database fields with values from an annotation file.\n\nTool homepage: https://github.com/ktmeaton/NCBImeta"
inputs:
  - id: database
    type: File
    doc: "Path to the sqlite database generated by NCBImeta."
    inputBinding:
      position: 1
      prefix: --database
  - id: table
    type: string
    doc: "Table in the NCBImeta database to modify."
    inputBinding:
      position: 1
      prefix: --table
  - id: annotfile
    type: File
    doc: "Path to the annotation file. The first column must contain a field that is unique to the record (ex. Accession)."
    inputBinding:
      position: 1
      prefix: --annotfile
  - id: concatenate
    type:
      - 'null'
      - boolean
    doc: "Concatenate annotations instead of replacing existing metadata."
    inputBinding:
      position: 1
      prefix: --concatenate
outputs:
  - id: annotated_database
    type: File
    doc: The modified sqlite database.
    outputBinding:
      glob: $(inputs.database.basename)
  - id: stdout
    type: stdout
    doc: Standard output
stdout: NCBImetaAnnotate.stdout.txt
requirements:
  - class: InlineJavascriptRequirement
  - class: InitialWorkDirRequirement
    listing:
      - entry: $(inputs.database)
        writable: true
hints:
  - class: DockerRequirement
    dockerPull: quay.io/biocontainers/ncbimeta:0.8.3--pyhdfd78af_0
