cwlVersion: v1.2
class: CommandLineTool
baseCommand:
  - bindash
  - dist
label: bindash_dist
doc: "Estimate distance (and relevant statistics) between genomes in query sketch and genomes in target-sketch. Query and target sketches are generated by the sketch command.\n\nTool homepage: https://github.com/zhaoxiaofei/bindash"
inputs:
  - id: query_sketch
    type: File
    doc: Sketch used as query, generated by "bindash sketch".
    secondaryFiles:
      - pattern: .dat
      - pattern: .txt
    inputBinding:
      position: 10
  - id: target_sketch
    type:
      - 'null'
      - File
    doc: Sketch used as target. If omitted, then query-sketch is used as both 
      query and target.
    secondaryFiles:
      - pattern: .dat
      - pattern: .txt
    inputBinding:
      position: 11
  - id: ithres
    type:
      - 'null'
      - int
    doc: 'If intersection(A, B) has less than this number of elements, then set the intersection to empty set so that the resulting Jaccard-index is zero. [0]'
    inputBinding:
      position: 1
      prefix: --ithres=
      separate: false
  - id: mthres
    type:
      - 'null'
      - float
    doc: 'Only results with at most this mutation distance are reported [2.5]'
    inputBinding:
      position: 1
      prefix: --mthres=
      separate: false
  - id: nneighbors
    type:
      - 'null'
      - int
    doc: 'Only this number of best-hit results per query are reported. If this value is zero then report all. [0].'
    inputBinding:
      position: 1
      prefix: --nneighbors=
      separate: false
  - id: nthreads
    type:
      - 'null'
      - int
    doc: 'This many threads will be spawned for processing. [20]'
    inputBinding:
      position: 1
      prefix: --nthreads=
      separate: false
  - id: model
    type:
      - 'null'
      - int
    doc: 'This will use a specific evolutionary model. 1 means Poisson model, default. 2 means Binomial model. [2]'
    inputBinding:
      position: 1
      prefix: --model=
      separate: false
  - id: pthres
    type:
      - 'null'
      - float
    doc: 'only results with at most this p-value are reported. [1.0001]'
    inputBinding:
      position: 1
      prefix: --pthres=
      separate: false
  - id: outfname
    type: string
    doc: 'The output file comparing the query and target sketches. Tab-separated fields per result line: query-sketch, target-sketch, mutation-distance, p-value, and jaccard-index. [-] ("-" means stdout).'
    default: bindash_dist.tsv
    inputBinding:
      position: 1
      prefix: --outfname=
      separate: false
outputs:
  - id: distances
    type: File
    doc: Tab-separated distance table.
    outputBinding:
      glob: $(inputs.outfname)
hints:
  - class: DockerRequirement
    dockerPull: quay.io/biocontainers/bindash:2.6--h077b44d_0
